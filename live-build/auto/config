#!/bin/sh
# live-build configuration for the Sysible Workstation ISO.
set -e

# Architecture is parameterized (SYSIBLE_ARCH): amd64 (default) or arm64.
# amd64 gets the hybrid BIOS+UEFI bootloaders; arm64 is UEFI-only (there is no
# BIOS/isolinux for it), so it uses grub-efi alone.
ARCH="${SYSIBLE_ARCH:-amd64}"
if [ "$ARCH" = "arm64" ]; then
  BOOTLOADERS="grub-efi"
else
  BOOTLOADERS="syslinux,grub-efi"
fi

lb config noauto \
  --distribution "${SYSIBLE_CODENAME:-bookworm}" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures "$ARCH" \
  --bootloaders "$BOOTLOADERS" \
  --binary-images iso-hybrid \
  --image-name "sysible-workstation" \
  --debian-installer none \
  --bootappend-live "boot=live components i915.enable_psr=0 i915.enable_dc=0 hostname=sysible-workstation username=sysible user-fullname=Sysible user-default-groups=sudo,kvm,libvirt,docker,wireshark,plugdev,netdev,video,audio" \
  --iso-application "Sysible Workstation" \
  --iso-publisher "Sysible" \
  --iso-volume "Sysible Workstation" \
  --memtest none \
  "${@}"
