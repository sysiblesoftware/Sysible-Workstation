#!/bin/sh
# Sysible Linux identity setup — HOSTNAME ONLY.
#
# SECURITY: this hook must NEVER bake a login account or a password into the
# squashfs. Doing so ships identical, publicly-known credentials on every image
# AND leaves a hidden account on every Calamares-installed system (a fleet-wide
# remote-root backdoor). The LIVE-session user is created at boot by live-config
# from the `username=` / `user-default-groups=` boot parameters in auto/config —
# it exists only in the runtime overlay, never in the installed image. The
# installed system's sole account is the one the Calamares users module creates
# during install. root keeps Debian's default LOCKED password. The build gate in
# 9500-sysible-verify.hook.chroot fails the build if any password is ever baked.
set -e

# Brand the hostname.
echo sysible > /etc/hostname
if grep -q '^127\.0\.1\.1' /etc/hosts 2>/dev/null; then
    sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tsysible/' /etc/hosts
else
    printf '127.0.1.1\tsysible\n' >> /etc/hosts
fi
