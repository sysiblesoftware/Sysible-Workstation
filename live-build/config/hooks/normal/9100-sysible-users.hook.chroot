#!/bin/sh
# Sysible Workstation live convenience account: user 'sysible' with NO baked
# password. The live session logs in through live-config's GDM autologin
# (username=sysible in auto/config --bootappend-live) with passwordless sudo,
# so no static credential is shipped. root ships LOCKED; Calamares
# (setRootPassword) establishes root on the installed target instead.
set -e
DEFUSER=sysible

if ! id "$DEFUSER" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "Sysible" "$DEFUSER"
fi
for g in sudo kvm libvirt docker wireshark plugdev netdev video audio; do
    groupadd -f "$g" 2>/dev/null || true
    usermod -aG "$g" "$DEFUSER" 2>/dev/null || true
done
# SECURITY: never bake a documented static password into the shipped image.
#  - root is LOCKED here; Calamares' setRootPassword owns root on install.
#  - 'sysible' ships with NO password hash and LOCKED, so there is no shippable
#    credential: `passwd -d` leaves the field empty (which Debian's
#    `pam_unix ... nullok` would otherwise accept as a valid empty password!) and
#    `passwd -l` then writes '!', which no password can ever match.
#
# DO NOT force-expire this account. `chage -d 0` was here, and it is what stopped
# the live session reaching a desktop at all:
#
#   chage -d 0 sets shadow's lstchg to 0, i.e. "must change password at next
#   login (root enforced)". GDM's autologin PAM stack (/etc/pam.d/gdm-autologin)
#   satisfies the AUTH phase with pam_permit and only consults pam_unix in the
#   ACCOUNT phase — which is precisely where that flag is enforced. So every boot
#   logged:
#       pam_unix(gdm-autologin:account): expired password for user sysible (root enforced)
#       pam_pwquality(gdm-autologin:chauthtok): conversation failed
#       pam_pwquality(gdm-autologin:chauthtok): user aborted password change
#   Autologin cannot run a password-change conversation, so the requirement was
#   unsatisfiable: GDM started, graphical.target was reached, and the session
#   never appeared. Locking the password gives the same "unusable credential"
#   property without making login impossible.
#
# The real protection for an INSTALLED disk is that the account is removed
# outright — see 9200-sysible-calamares-removeuser. This is defence in depth
# behind it, not the primary control.
passwd -l root
passwd -d "$DEFUSER"
passwd -l "$DEFUSER"

# Brand the hostname. This seeds the chroot; at LIVE boot live-config re-applies
# the hostname from the `hostname=` kernel arg in auto/config's --bootappend-live
# (without that arg live-config forces its built-in default 'debian', which is
# what made Calamares' "name for this computer" field pre-fill 'debian'). Keep
# both in sync at 'sysible-workstation' so the live host, the installer default,
# and a from-skel install all read the same name.
echo sysible-workstation > /etc/hostname
if grep -q '^127\.0\.1\.1' /etc/hosts 2>/dev/null; then
    sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tsysible-workstation/' /etc/hosts
else
    printf '127.0.1.1\tsysible-workstation\n' >> /etc/hosts
fi
