#!/bin/sh
# Sysible Workstation live convenience account: user 'sysible' with NO baked
# password. The live session logs in through live-config's GDM autologin
# (username=sysible in auto/config --bootappend-live) with passwordless sudo,
# so no static credential is shipped. root ships LOCKED; Calamares
# (setRootPassword) establishes root on the installed target instead.
set -e
DEFUSER=sysible

if ! id "$DEFUSER" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "Sysible" "$DEFUSER"
fi
for g in sudo kvm libvirt docker wireshark plugdev netdev video audio; do
    groupadd -f "$g" 2>/dev/null || true
    usermod -aG "$g" "$DEFUSER" 2>/dev/null || true
done
# SECURITY: never bake a documented static password into the shipped image.
#  - root is LOCKED here; Calamares' setRootPassword owns root on install.
#  - 'sysible' ships WITHOUT a password (matching live-config's passwordless
#    autologin model) and is force-expired, so it carries no shippable default
#    credential and — if the account ever survives onto an installed disk (see
#    9200-sysible-calamares-removeuser) — first interactive login demands a
#    real password before the account can be used.
passwd -l root
passwd -d "$DEFUSER"
chage -d 0 "$DEFUSER"

# Brand the hostname. This seeds the chroot; at LIVE boot live-config re-applies
# the hostname from the `hostname=` kernel arg in auto/config's --bootappend-live
# (without that arg live-config forces its built-in default 'debian', which is
# what made Calamares' "name for this computer" field pre-fill 'debian'). Keep
# both in sync at 'sysible-workstation' so the live host, the installer default,
# and a from-skel install all read the same name.
echo sysible-workstation > /etc/hostname
if grep -q '^127\.0\.1\.1' /etc/hosts 2>/dev/null; then
    sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tsysible-workstation/' /etc/hosts
else
    printf '127.0.1.1\tsysible-workstation\n' >> /etc/hosts
fi
