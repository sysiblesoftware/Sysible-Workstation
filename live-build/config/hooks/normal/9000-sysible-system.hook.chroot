#!/bin/sh
set -e

# GNOME shell extensions — the bottom dock (dash-to-dock) and desktop icons
# (DING). Their Debian package names differ from Ubuntu's, so install them
# best-effort here (trying the known Debian names) rather than in the hard
# package list, where a single unknown name aborts the whole ISO build. If none
# resolve, the desktop still works; the gschema just enables extensions that
# aren't present, which GNOME ignores.
apt-get update 2>/dev/null || true
# gnome-shell-extensions provides the top-bar workspace-indicator (enabled in the
# dconf defaults) for the Kali-style fixed workspaces.
for pkg in gnome-shell-extension-dashtodock gnome-shell-extension-dash-to-dock \
           gnome-shell-extension-desktop-icons-ng gnome-shell-extension-ubuntu-dock \
           gnome-shell-extensions; do
    if apt-get install -y --no-install-recommends "$pkg" 2>/dev/null; then
        echo "Sysible: installed GNOME extension $pkg"
    else
        echo "Sysible: optional GNOME extension $pkg not available — skipping"
    fi
done

# os-release / issue branding. ID_LIKE=debian keeps third-party scripts happy.
cat > /etc/os-release <<OSREL
PRETTY_NAME="Sysible Workstation — Engineering Automation Cloud"
NAME="Sysible Workstation"
ID=sysible
ID_LIKE=debian
VERSION="1.0.2 (Ignition)"
VERSION_ID="1.0.2"
VERSION_CODENAME=ignition
HOME_URL="https://sysible.com"
SUPPORT_URL="https://sysible.com/controller"
LOGO=sysible-logo
OSREL
printf 'Sysible Workstation — Engineering Automation Cloud \\n \\l\n\n' > /etc/issue
echo "Sysible Workstation — Engineering Automation Cloud" > /etc/issue.net

# MOTD — remove the Debian boilerplate shown on a console login. Two sources:
#   1. /etc/motd (base-files): "The programs included with the Debian GNU/Linux
#      system are free software ... ABSOLUTELY NO WARRANTY ..."
#   2. /etc/update-motd.d/10-uname: prints "Linux <host> <kernel> ... Debian ..."
#      into /run/motd.dynamic, which pam_motd then displays.
# Replace (1) with a short Sysible banner and disable (2).
cat > /etc/motd <<'MOTD'

Sysible Workstation — Engineering Automation Cloud
Docs: https://sysible.com

MOTD
chmod -x /etc/update-motd.d/10-uname 2>/dev/null || true
rm -f /run/motd.dynamic 2>/dev/null || true
# SSH is ON by default on Sysible Workstation and accepts password logins (it's an
# engineering workstation you're expected to reach over the network). No Sysible
# drop-in — we use the stock /etc/ssh/sshd_config and just make sure password auth
# is on there (Debian's default is already yes; set it explicitly so it's the
# documented default). Host keys are NOT baked into the image — the firstboot
# service (9600 hook) regenerates them per machine. Enable the service (unit is
# `ssh`; disable the socket-activation unit so the daemon just runs, and fail2ban's
# ssh jail — shipped active — guards it against brute force).
# Enable the boot services. IMPORTANT: `systemctl enable` is UNRELIABLE inside the
# live-build chroot — there is no running systemd/dbus, so it can be a silent no-op
# (the exact same trap documented for the wait-online masks below). That is what left
# graphical.target.wants/ WITHOUT a display manager: a normal boot reached
# graphical.target and then sat at the last message with no greeter, while a manual
# `systemctl start gdm3` worked fine. Use deb-systemd-helper, which manages the enable
# symlinks OFFLINE (it's what dpkg postinsts use), with systemctl only as a fallback.
for svc in gdm3 libvirtd docker ssh; do
    deb-systemd-helper enable "$svc.service" 2>/dev/null \
        || systemctl enable "$svc" 2>/dev/null || true
done
# Belt-and-suspenders for the display manager specifically (the boot-critical one):
# guarantee graphical.target starts GDM by laying the want symlink down BY HAND — a
# .wants/ symlink IS the dependency, independent of the unit's [Install] quirks or any
# chroot tooling. Also register GDM as the default display manager (gdm3's own postinst
# skips enabling itself when this file is missing or points elsewhere).
mkdir -p /etc/systemd/system/graphical.target.wants
ln -sf /lib/systemd/system/gdm3.service /etc/systemd/system/graphical.target.wants/gdm3.service
echo /usr/sbin/gdm3 > /etc/X11/default-display-manager 2>/dev/null || true

# --- Recovery console (opt-in, via the GRUB "recovery console" entry) --------
# The live session ships root LOCKED and the 'sysible' user WITHOUT a usable
# password (GDM autologins it; a plain getty login can't). So if the graphical
# boot ever fails again, there'd be no way to log in at a text console to look. This
# gives one: a passwordless root shell ON tty1 (the visible screen — no VT switching
# needed), but ONLY when the kernel cmdline carries `sysible.recovery`. The recovery
# GRUB entry adds that flag AND boots multi-user.target, so GDM is out of the way and
# systemctl works for diagnosis (e.g. `systemctl start gdm3`). agetty --autologin
# root uses `login -f` (auth skipped), so the locked root password is not in the way.
# On a NORMAL boot the ConditionKernelCommandLine fails, the unit is skipped, and the
# standard getty@tty1 is untouched — the entry is fully inert unless chosen.
cat > /etc/systemd/system/sysible-recovery-shell.service <<'RECOV'
[Unit]
Description=Sysible recovery root shell on tty1 (sysible.recovery only)
Documentation=https://sysible.com
ConditionKernelCommandLine=sysible.recovery
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service plymouth-quit-wait.service
[Service]
Type=idle
ExecStart=-/sbin/agetty --autologin root --noclear --keep-baud tty1 $TERM
Restart=always
UtmpIdentifier=tty1
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
KillMode=process
[Install]
WantedBy=multi-user.target
RECOV
# Enable it OFFLINE (chroot-safe: `systemctl enable` is a silent no-op in this chroot
# — the same trap the GDM want above documents). ConditionKernelCommandLine keeps it
# inert unless the recovery entry is chosen, so a normal boot never sees it.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/sysible-recovery-shell.service \
    /etc/systemd/system/multi-user.target.wants/sysible-recovery-shell.service

# Also disable the ssh SOCKET unit the chroot-safe way, so the daemon just runs.
deb-systemd-helper disable ssh.socket 2>/dev/null || systemctl disable ssh.socket 2>/dev/null || true
if [ -f /etc/ssh/sshd_config ]; then
    if grep -qiE '^[#[:space:]]*PasswordAuthentication' /etc/ssh/sshd_config; then
        sed -i 's/^[#[:space:]]*[Pp]assword[Aa]uthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    else
        printf '\nPasswordAuthentication yes\n' >> /etc/ssh/sshd_config
    fi
fi
# Never block boot waiting for a network that may not come up (no Wi-Fi firmware,
# no cable) — a desktop must reach the login screen regardless. The wait-online
# services hold network-online.target (pulled in by docker.service et al.) until
# the network is up, up to ~90s, which on bare metal without a usable NIC looks
# like a boot "hang" at the networking step ("A start job is running for Wait for
# Network to be Configured"). Mask them so network-online.target is reached
# immediately; NetworkManager still brings links up asynchronously once the
# firmware/driver are present, and services that truly need the network are ordered
# After= it and just run when it arrives.
#
# Done by hand (ln -> /dev/null), NOT `systemctl mask`: inside the live-build
# chroot there is no running systemd/dbus, so `systemctl mask` is a silent no-op
# and the mask never lands in the image (this is exactly why it kept hanging). The
# symlink IS the mask on disk and always persists — same technique as the sleep
# targets below.
for svc in NetworkManager-wait-online.service systemd-networkd-wait-online.service; do
    ln -sf /dev/null "/etc/systemd/system/$svc"
done
for grp in sudo kvm libvirt docker wireshark; do groupadd -f "$grp" 2>/dev/null || true; done

# Idle auto-suspend is disabled via GNOME (16_sysible-power.gschema.override sets
# sleep-inactive-*-type='nothing'), so a workstation/VM never drops to sleep on idle
# and "freezes". But suspend itself is LEFT AVAILABLE: a laptop must be able to
# suspend on lid-close or on request. We used to also mask the systemd sleep targets
# (ln -> /dev/null), which made suspend fail hard on laptops — "suspend.target is
# masked, refusing operation" / "Failed to execute suspend operation: Permission
# denied" on every lid close. Do NOT mask them. (If any were masked by a previous
# image, unmask them.)
for t in sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target; do
    [ -L "/etc/systemd/system/$t" ] && rm -f "/etc/systemd/system/$t"
done

# Drop Debian's (and GNOME's stock) default wallpapers — Sysible ships its own
# set (sysible-artwork, under /usr/share/backgrounds/sysible) and sets Mesh-dark
# as the default via gschema. Remove every background-chooser registration except
# Sysible's own so ONLY our wallpapers appear in Settings > Appearance, and delete
# the Debian/GNOME image files themselves.
for x in /usr/share/gnome-background-properties/*.xml; do
    case "$x" in */sysible.xml) ;; *) rm -f "$x" ;; esac
done
rm -rf /usr/share/images/desktop-base
rm -rf /usr/share/desktop-base/*-theme/wallpaper
rm -f  /usr/share/backgrounds/*.jpg /usr/share/backgrounds/*.png 2>/dev/null || true
rm -rf /usr/share/backgrounds/gnome 2>/dev/null || true

# Remove every stock Calamares launcher (upstream "Install System", Debian's
# "Install Debian", etc.) so only Sysible's own "Install Sysible Workstation" appears.
# Match by Exec=calamares or an installer Name, but never touch our own launchers.
for f in /usr/share/applications/*.desktop; do
    [ -f "$f" ] || continue
    case "$f" in
        */install-sysible-workstation.desktop|*/sysible-controller-install.desktop|*/sysible-slop-install.desktop|*/sysible-slep-install.desktop) continue ;;
    esac
    if grep -qiE '^Exec=.*calamares' "$f" 2>/dev/null \
       || grep -qiE '^(Name|GenericName)=[[:space:]]*(Install System|Install Debian|Calamares)' "$f" 2>/dev/null; then
        rm -f "$f"
    fi
done

# Refresh the icon cache so the Sysible SysTerm icon (shipped via includes.chroot
# to override the packaged one) and other hicolor icons resolve.
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/Adwaita 2>/dev/null || true

# Make SysTerm the system-wide terminal so "Open Terminal" everywhere — the
# desktop-icons (DING) right-click menu, file managers, and apps that spawn
# x-terminal-emulator — all launch SysTerm.
SYSTERM_BIN=$(command -v systerm 2>/dev/null || true)
[ -x /usr/bin/systerm ] && SYSTERM_BIN=/usr/bin/systerm
if [ -n "$SYSTERM_BIN" ]; then
    update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator "$SYSTERM_BIN" 60 2>/dev/null || true
    update-alternatives --set x-terminal-emulator "$SYSTERM_BIN" 2>/dev/null || true
fi
# GNOME's desktop-icons "Open Terminal" probes for known terminal binaries by
# name (gnome-terminal / kgx / gnome-console) rather than x-terminal-emulator,
# so shim those names to the SysTerm wrapper. /usr/local/bin precedes /usr/bin
# on PATH, so these win even if a real one is ever installed.
chmod +x /usr/local/bin/sysible-term 2>/dev/null || true
# Shim the well-known terminal names in BOTH /usr/local/bin and /usr/bin. GNOME's
# Files/desktop "Open Terminal" (nautilus-extension-gnome-terminal, DING) spawns
# `gnome-terminal` via the standard PATH, which on Wayland often omits
# /usr/local/bin — so without the /usr/bin shim it finds nothing and silently
# does nothing. The real gnome-terminal app isn't installed, so /usr/bin is free.
for t in gnome-terminal kgx gnome-console; do
    ln -sf /usr/local/bin/sysible-term "/usr/local/bin/$t" 2>/dev/null || true
    [ -e "/usr/bin/$t" ] || ln -sf /usr/local/bin/sysible-term "/usr/bin/$t" 2>/dev/null || true
done

# User avatar: GNOME's polkit dialog (e.g. the installer's "Authentication
# Required") shows the login user's .face. Replace Debian's swirl with the
# Sysible mark for the live user and any account created from /etc/skel.
if [ -f /usr/share/pixmaps/sysible-face.png ]; then
    cp -f /usr/share/pixmaps/sysible-face.png /etc/skel/.face
    cp -f /usr/share/pixmaps/sysible-face.png /etc/skel/.face.icon 2>/dev/null || true
    # Seed AccountsService for the usual live usernames so the avatar is set
    # even where AccountsService takes precedence over ~/.face.
    mkdir -p /var/lib/AccountsService/icons /var/lib/AccountsService/users
    for u in sysible user; do
        cp -f /usr/share/pixmaps/sysible-face.png "/var/lib/AccountsService/icons/$u"
        cat > "/var/lib/AccountsService/users/$u" <<AS
[User]
Icon=/var/lib/AccountsService/icons/$u
AS
    done
fi
# Drop any Debian-branded faces that could otherwise win.
rm -f /usr/share/pixmaps/faces/debian* 2>/dev/null || true

# Point Calamares at the Sysible branding (shipped in /etc/calamares/branding/
# sysible) so the installer reads "Sysible Workstation", not "Debian GNU/Linux".
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's|^\([[:space:]]*-\?[[:space:]]*\)branding:.*|\1branding: sysible|' /etc/calamares/settings.conf
    grep -q 'branding: sysible' /etc/calamares/settings.conf || \
        printf '\nbranding: sysible\n' >> /etc/calamares/settings.conf
fi

# GRUB entry titles: "Sysible Workstation", not "Sysible Workstation GNU/Linux".
# grub-mkconfig's /etc/grub.d/10_linux hard-codes the title as
# "${GRUB_DISTRIBUTOR} GNU/Linux"; since GRUB_DISTRIBUTOR is already the full
# product name ("Sysible Workstation", set in 20_sysible-theme.cfg), drop the
# " GNU/Linux" suffix entirely so the title is exactly the product name (the same
# special-casing Ubuntu does for its own entries). Idempotent, and only touches
# that exact string. Calamares copies this patched file to the target and runs
# update-grub there, so the installed system's menu reads "Sysible Workstation"
# everywhere (main entry, "Advanced options for …", recovery).
if [ -f /etc/grub.d/10_linux ]; then
    sed -i 's|${GRUB_DISTRIBUTOR} GNU/Linux|${GRUB_DISTRIBUTOR}|g' /etc/grub.d/10_linux
fi

# Boot/shutdown splash: make the shipped Sysible Plymouth theme the default so
# boot and reboot show the Sysible mark, not Debian's "debian 12" splash. This
# writes ONLY the default-theme config into the rootfs (plymouth-set-default-theme
# without -R does not touch the initramfs). The installer copies it to disk and
# rebuilds the TARGET initramfs on install, so installed systems get the splash.
#
# Do NOT run `update-initramfs -u` here. Regenerating the initramfs inside the
# live-build chroot replaces the working live-boot initramfs (the one that knows
# how to find and mount the squashfs) with one that cannot — so the LIVE boot drops
# to a BusyBox (initramfs) prompt and never reaches systemd. live-build already
# built a bootable live initramfs when live-boot was installed; leave it alone. The
# live session just boots without the custom splash (cosmetic); the installed
# system still gets it via the Calamares initramfs rebuild above.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme sysible 2>/dev/null || true
fi

# Display server: leave GDM's default (Wayland where the hardware supports it,
# automatic fallback to Xorg otherwise) — exactly what stock Debian does. Stock
# Debian reaches the desktop on the same hardware we were wedging on, so the
# universal rule is to match its graphical path rather than force a non-stock
# delta. Forcing WaylandEnable=false was tried (ISO #22) and did NOT fix the
# greeter wedge, which confirms the display server was never the cause. If an
# earlier build left the override in place, strip it back to stock.
if [ -f /etc/gdm3/daemon.conf ]; then
    sed -i 's/^\s*WaylandEnable\s*=.*/#WaylandEnable=false/' /etc/gdm3/daemon.conf
fi

# Lock / login screen branding — SAFE method only. We do NOT rebuild the GNOME
# Shell theme gresource anymore: overwriting gnome-shell's own compiled resource
# is the single non-stock delta that sits in the boot-to-greeter path and can
# wedge the greeter on some GPUs (stock Debian reaches the desktop on the same
# hardware). Greeter logo removal + background hint live entirely in the gdm dconf
# profile written below (the supported, boot-safe path). apply-login-background is
# now a boot-safe no-op stub that only re-asserts that dconf state.
chmod 0755 /usr/lib/sysible/apply-login-background /usr/lib/sysible/branding-guard 2>/dev/null || true
/usr/lib/sysible/apply-login-background || true

# Branding guard: re-assert package-owned branding (os-release, the greeter
# background, GRUB titles) after every apt/dpkg upgrade and on boot, so an
# `apt upgrade` (or unattended-upgrades) can't quietly revert it.
systemctl enable sysible-branding-guard.service 2>/dev/null || true

# GDM greeter branding via the gdm dconf profile. Two things here:
#  * background — harmless belt-and-suspenders (the gresource rebuild above is
#    what actually paints the greeter background on Debian).
#  * logo — remove Debian's "debian 12" watermark from the bottom of the login
#    screen. Pointing the key at a real (transparent) file is far more reliable
#    than logo='' (which some GDM builds treat as "unset → fall back"): GDM draws
#    our transparent image, i.e. nothing, so the branding is just the subtle
#    "SYSIBLE WORKSTATION" wordmark baked into the background — one sleek element, not a
#    huge GDM-scaled lockup. A high-numbered keyfile wins keyfile ordering and the
#    lock makes our value authoritative so nothing can flip it back.
mkdir -p /etc/dconf/db/gdm.d /etc/dconf/db/gdm.d/locks
cat > /etc/dconf/db/gdm.d/95-sysible-login <<'DCONF'
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/sysible/sysible-login.png'
picture-uri-dark='file:///usr/share/backgrounds/sysible/sysible-login.png'
picture-options='zoom'

[org/gnome/login-screen]
logo='/usr/share/pixmaps/sysible-login-logo.png'
banner-message-enable=false
DCONF
cat > /etc/dconf/db/gdm.d/locks/95-sysible-login <<'LOCK'
/org/gnome/login-screen/logo
LOCK
# Debian also ships the greeter default in /etc/gdm3/greeter.dconf-defaults; set
# the logo there too so the value is consistent regardless of which source wins.
if [ -f /etc/gdm3/greeter.dconf-defaults ]; then
    sed -i "/^\s*logo\s*=/d" /etc/gdm3/greeter.dconf-defaults
    if grep -q '^\[org/gnome/login-screen\]' /etc/gdm3/greeter.dconf-defaults; then
        sed -i "/^\[org\/gnome\/login-screen\]/a logo='/usr/share/pixmaps/sysible-login-logo.png'" \
            /etc/gdm3/greeter.dconf-defaults
    else
        printf '\n[org/gnome/login-screen]\nlogo=%s\n' \
            "'/usr/share/pixmaps/sysible-login-logo.png'" >> /etc/gdm3/greeter.dconf-defaults
    fi
fi
dconf update 2>/dev/null || true

# Sysible AI shell helper: /etc/profile.d is only read by LOGIN shells, but
# terminals (SysTerm, gnome-terminal) start interactive NON-login shells that
# read /etc/bash.bashrc. Source our helper from there too so `sai` and the
# failed-command hint are available in a terminal, not just a login shell.
if [ -f /etc/bash.bashrc ] && ! grep -q 'profile.d/sysible-ai.sh' /etc/bash.bashrc; then
    cat >> /etc/bash.bashrc <<'BRC'

# Sysible AI terminal companion (interactive shells).
if [ -n "$PS1" ] && [ -f /etc/profile.d/sysible-ai.sh ]; then
    . /etc/profile.d/sysible-ai.sh
fi
BRC
fi

# Compile the shipped gschema override (enables desktop icons + SysTerm terminal).
glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
