#!/bin/sh
# Build-time guarantee. Runs after packages are installed and FAILS the whole ISO
# build if the image didn't actually get the fixed SysTerm. This closes the gap
# where we build 0.1.9 but the image could still install something older — a
# green build now proves 0.1.9 + the Run Command menu + the new icon are present.
set -e

fail() { echo "SYSIBLE-VERIFY FATAL: $1" >&2; exit 1; }

# 1) SysTerm package version actually INSTALLED (not just the .deb we built).
V=$(dpkg-query -W -f='${Version}' systerm 2>/dev/null || echo none)
echo "sysible-verify: installed systerm = $V"
[ "$V" != none ] || fail "systerm is not installed"
dpkg --compare-versions "$V" ge 0.1.9 || fail "systerm $V installed, need >= 0.1.9"

# 2) The Run Command right-click menu is in the installed code.
WIN=$(dpkg -L systerm 2>/dev/null | grep '/systerm/window\.py$' | head -1)
{ [ -n "$WIN" ] && [ -f "$WIN" ] && grep -q 'Run Command' "$WIN"; } \
    || fail "Run Command menu missing from installed SysTerm ($WIN)"

# 3) The canonical ">_" prompt icon is the WINNING on-disk icon. SysTerm's own .deb
# and our includes.chroot both ship io.systerm.SysTerm.svg to the same path; whoever
# is applied last wins. Assert the file actually on disk is the ">_" design (brand
# green #6ddb73 prompt) so a drift between the two sources can never ship silently.
ICON=/usr/share/icons/hicolor/scalable/apps/io.systerm.SysTerm.svg
[ -f "$ICON" ] || fail "SysTerm icon missing ($ICON)"
grep -q '6ddb73' "$ICON" 2>/dev/null \
    || fail "SysTerm icon on disk is not the canonical >_ design (expected #6ddb73 in $ICON)"

# 4) The target bootloader is installable offline. grub must be INSTALLED in the
# live chroot so its .deb is in the ISO pool and already in the unpacked target;
# otherwise Calamares dies with "grub-efi-amd64 has no installation candidate"
# and "update-grub: No such file or directory". Assert both the arch grub-efi
# package and update-grub are actually here.
ARCH=$(dpkg --print-architecture 2>/dev/null || echo unknown)
case "$ARCH" in
    arm64) GRUB_PKG=grub-efi-arm64 ;;
    amd64) GRUB_PKG=grub-efi-amd64 ;;
    *)     GRUB_PKG=grub-efi-amd64 ;;
esac
dpkg-query -W -f='${Status}' "$GRUB_PKG" 2>/dev/null | grep -q 'install ok installed' \
    || fail "$GRUB_PKG not installed — Calamares cannot install GRUB into the target offline"
[ -x /usr/sbin/update-grub ] || fail "/usr/sbin/update-grub missing — grub-common not installed"
echo "sysible-verify: OK — $GRUB_PKG installed, update-grub present (target install can bootload)."

# 5) GDM greeter is de-Debianised: our login watermark is installed and wired as
# the login-screen logo (replacing "debian 12").
[ -f /usr/share/pixmaps/sysible-login-logo.png ] \
    || fail "Sysible login watermark missing (/usr/share/pixmaps/sysible-login-logo.png)"
grep -rqs "sysible-login-logo.png" /etc/dconf/db/gdm.d/ \
    || fail "GDM login-screen logo not pointed at the Sysible watermark"
echo "sysible-verify: OK — GDM login watermark installed and wired."

# 6) Branding integrity. Every logo in the image (GRUB boot menu, Plymouth,
# Calamares, GDM, app-grid) is rendered from ONE canonical mark
# (branding/logo/sysible-mark.svg) and its sha256 recorded in a manifest shipped
# into the image. Assert the on-disk files still match — this is what stops the
# GRUB boot logo from silently drifting back to old art while the dock icon is
# fixed. Env-independent: just sha256 of the committed bytes.
BMAN=/usr/share/sysible/branding.manifest
[ -f "$BMAN" ] || fail "branding manifest missing ($BMAN)"
PREFIX=live-build/config/includes.chroot
checked=0
while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    sha=${line%% *}
    rel=${line#* }
    rel=${rel# }
    # Only the assets that actually land in the installed root (under
    # includes.chroot); ISO-only splashes and repo README badges are skipped here
    # and covered by scripts/verify-branding.sh in CI instead.
    case "$rel" in
        "$PREFIX"/*) img="/${rel#"$PREFIX"/}" ;;
        *) continue ;;
    esac
    [ -f "$img" ] || fail "branded asset missing from image: $img"
    act=$(sha256sum "$img" 2>/dev/null | awk '{print $1}')
    [ "$act" = "$sha" ] || fail "branded asset drifted from the canonical mark: $img"
    checked=$((checked + 1))
done < "$BMAN"
[ "$checked" -gt 0 ] || fail "branding manifest matched no in-image assets"
echo "sysible-verify: OK — $checked branded assets match the canonical mark (incl. GRUB boot logo)."

# 7) The greeter must not be gated by our own units, and Plymouth must not be able
# to deadlock the live boot. Root cause of the "boots to a black screen with no
# login screen" hang: gdm.service is ordered After=plymouth-quit.service AND
# Conflicts= it, while plymouth-quit-wait.service runs `plymouth --wait` with
# TimeoutSec=0 (infinite). If plymouthd wedges on the panel, the wait never
# returns, multi-user.target never completes, graphical.target is never reached and
# GDM NEVER STARTS (journalctl -u gdm shows no entries at all) — yet a manual
# `systemctl start gdm3` works, because that bypasses the target dependency. The
# live boot requests no splash and never rebuilds the initramfs, so Plymouth adds
# nothing there; plymouth.enable=0 in the live cmdline removes the deadlock. The
# INSTALLED system is unaffected (it has its own cmdline via /etc/default/grub.d).
for _u in /usr/lib/systemd/system/sysible-avatar.service \
          /usr/lib/systemd/system/sysible-branding-guard.service; do
    [ -f "$_u" ] || continue
    ! grep -q '^Before=.*\(gdm\|display-manager\)' "$_u" \
        || fail "$_u is ordered Before=gdm — cosmetic branding must never gate the login screen"
done
echo "sysible-verify: OK — no Sysible unit gates the display manager."

# 8) The live user must be LOGINABLE-BY-AUTOLOGIN and carry NO usable credential.
# Second root cause of "GDM starts, graphical.target is reached, no session ever
# appears": 9100-sysible-users ran `chage -d 0 sysible`, which sets shadow's
# lstchg to 0 — "must change password at next login (root enforced)". GDM's
# autologin stack satisfies AUTH with pam_permit and consults pam_unix only in the
# ACCOUNT phase, which is exactly where that flag is enforced, so every boot
# logged "expired password for user sysible (root enforced)" followed by
# "conversation failed / user aborted password change". Autologin cannot run a
# password-change conversation, so the requirement was UNSATISFIABLE and the
# desktop never drew. Assert both halves so neither can regress:
#   * lstchg must NOT be 0 (not force-expired), or autologin is impossible;
#   * the password field MUST be locked ('!'/'*') and never a real hash or empty
#     — empty would be accepted by Debian's `pam_unix ... nullok`.
_LU=sysible
_shadow=$(getent shadow "$_LU" 2>/dev/null || true)
if [ -n "$_shadow" ]; then
    _pw=$(printf '%s' "$_shadow" | cut -d: -f2)
    _lstchg=$(printf '%s' "$_shadow" | cut -d: -f3)
    [ "$_lstchg" != "0" ] \
        || fail "live user '$_LU' is force-expired (lstchg=0) — GDM autologin cannot satisfy a password change, so the desktop will never appear. Do not use 'chage -d 0' here."
    case "$_pw" in
        "") fail "live user '$_LU' has an EMPTY password — Debian's pam_unix nullok would accept it. Lock it with 'passwd -l'." ;;
        '!'*|'*'*) : ;;   # locked: no password can ever match
        *) fail "live user '$_LU' ships a real password hash — never bake a credential into the image." ;;
    esac
    echo "sysible-verify: OK — live user '$_LU' is locked (no usable credential) and not force-expired."
else
    fail "live user '$_LU' is missing from the image"
fi

# 9) The live session must have a route to root and no lock screen.
# These are the consequences of section 8: the live account is LOCKED, so it can
# neither authenticate to sudo nor unlock a lock screen. Without a passwordless
# sudoers entry the live session has no way to become root at all; without the
# lock being disabled, closing a laptop lid suspends, GNOME locks on resume, and
# the session is unrecoverable. Both are set up by the live-config script below,
# which runs ONLY on a live boot — assert it ships, is executable, and that the
# sudoers line it writes actually parses. A malformed sudoers.d file does not
# degrade gracefully: sudo refuses to run at all, which would be a worse failure
# than the one this prevents.
_LC=/lib/live/config/2999-sysible-live-session
[ -f "$_LC" ] || fail "$_LC is missing — the live session would have no passwordless sudo and an unescapable lock screen"
[ -x "$_LC" ] || fail "$_LC is not executable, so live-config will not run it"
grep -q 'NOPASSWD' "$_LC" || fail "$_LC no longer grants the live user passwordless sudo"
grep -q 'lock-enabled=false' "$_LC" || fail "$_LC no longer disables the live lock screen"
# pkexec authenticates through polkit, which does NOT read sudoers — without this
# rule the installer raises a password dialog the locked live account can never
# answer, and the system cannot be installed at all.
grep -q 'polkit.addRule' "$_LC" || fail "$_LC no longer grants the live user the installer's polkit action — 'Install Sysible Workstation' would ask for a password that does not exist"
grep -q 'calamares' "$_LC" || fail "$_LC's polkit rule no longer mentions calamares"
grep -q 'subject.active' "$_LC" || fail "$_LC's polkit rule no longer requires a local ACTIVE session — it must not grant a remote or background caller"
# Both launchers must go through the wrapper, and the wrapper must keep BOTH
# routes to root. The polkit rule alone is a single point of failure — a rule that
# is not read, a different action id, a polkitd without JS rules, and the operator
# is back at an unanswerable password dialog with an ISO that cannot be installed.
# The wrapper's sudo fallback is what makes that impossible, so it is checked as
# hard as the rule itself.
_LAUNCH=/usr/local/bin/sysible-os-installer
[ -x "$_LAUNCH" ] || fail "$_LAUNCH is missing or not executable — the installer has no launcher"
grep -q 'pkexec' "$_LAUNCH" || fail "$_LAUNCH no longer tries pkexec (the supported path)"
grep -q 'sudo -E calamares' "$_LAUNCH" || fail "$_LAUNCH lost its sudo fallback — a polkit failure would leave the ISO uninstallable"
for _d in /usr/share/applications/install-sysible-workstation.desktop /usr/local/bin/sysible-live-installer; do
    [ -f "$_d" ] || fail "$_d is missing — the installer has no launcher"
    grep -q 'sysible-os-installer' "$_d" || fail "$_d does not start the installer through $_LAUNCH"
    grep -q 'pkexec calamares' "$_d" && fail "$_d still calls pkexec directly, bypassing the sudo fallback"
done
if command -v visudo >/dev/null 2>&1; then
    _t=$(mktemp)
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$_LU" > "$_t"
    visudo -c -f "$_t" >/dev/null 2>&1 || { rm -f "$_t"; fail "the sudoers line for '$_LU' does not parse — sudo would refuse to run"; }
    rm -f "$_t"
    echo "sysible-verify: OK — live sudoers line parses; lock screen disabled for the live session."
else
    echo "sysible-verify: OK — live-config session script present (visudo unavailable to parse-check)."
fi

# 10) The AI model feature must stay GONE.
# `sysible ai` / `sai`, the /etc/profile.d helper and the bundled Ollama runtime
# were removed on request. This asserts the IMAGE is actually free of them, not
# just the recipe: a hook that silently stopped applying, a stale file surviving
# in includes.chroot, or a package pulling ollama back in would otherwise ship a
# feature that was deliberately taken out — and a model server enabled at boot.
for _gone in /etc/profile.d/sysible-ai.sh /usr/local/bin/ollama \
             /etc/systemd/system/ollama.service; do
    [ -e "$_gone" ] && fail "$_gone is present, but the AI model feature was removed"
done
if command -v sysible >/dev/null 2>&1; then
    sysible --help 2>&1 | grep -qiw 'ai' \
        && fail "the 'sysible' CLI still offers an 'ai' subcommand"
fi
grep -rqs 'profile.d/sysible-ai.sh' /etc/bash.bashrc \
    && fail "/etc/bash.bashrc still sources the removed AI shell helper"
id ollama >/dev/null 2>&1 && fail "the 'ollama' service account is still in the image"
# The SysTerm companion pane is part of the same feature and is built from its
# own repo during this build, so check the INSTALLED package too — a stale .deb or
# a build that picked up an older branch would put the AI pane straight back.
if [ -d /usr/lib/python3 ]; then
    find /usr/lib/python3 -path '*systerm/atlas.py' 2>/dev/null | grep -q . \
        && fail "the SysTerm Atlas companion module is still installed"
fi
[ -e /etc/profile.d/systerm-atlas.sh ] && fail "SysTerm's Atlas shell hook is still installed"
echo "sysible-verify: OK — no AI model feature in the image (no sysible ai, no sai, no ollama)."

echo "sysible-verify: OK — SysTerm $V, Run Command menu, and new icon all present."
