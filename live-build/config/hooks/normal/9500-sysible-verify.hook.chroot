#!/bin/sh
# Build-time guarantee. Runs after packages are installed and FAILS the whole ISO
# build if the image didn't actually get the fixed SysTerm. This closes the gap
# where we build 0.1.9 but the image could still install something older — a
# green build now proves 0.1.9 + the Run Command menu + the new icon are present.
set -e

fail() { echo "SYSIBLE-VERIFY FATAL: $1" >&2; exit 1; }

# 1) SysTerm package version actually INSTALLED (not just the .deb we built).
V=$(dpkg-query -W -f='${Version}' systerm 2>/dev/null || echo none)
echo "sysible-verify: installed systerm = $V"
[ "$V" != none ] || fail "systerm is not installed"
dpkg --compare-versions "$V" ge 0.1.9 || fail "systerm $V installed, need >= 0.1.9"

# 2) The Run Command right-click menu is in the installed code.
WIN=$(dpkg -L systerm 2>/dev/null | grep '/systerm/window\.py$' | head -1)
{ [ -n "$WIN" ] && [ -f "$WIN" ] && grep -q 'Run Command' "$WIN"; } \
    || fail "Run Command menu missing from installed SysTerm ($WIN)"

# 3) The canonical ">_" prompt icon is the WINNING on-disk icon. SysTerm's own .deb
# and our includes.chroot both ship io.systerm.SysTerm.svg to the same path; whoever
# is applied last wins. Assert the file actually on disk is the ">_" design (brand
# green #6ddb73 prompt) so a drift between the two sources can never ship silently.
ICON=/usr/share/icons/hicolor/scalable/apps/io.systerm.SysTerm.svg
[ -f "$ICON" ] || fail "SysTerm icon missing ($ICON)"
grep -q '6ddb73' "$ICON" 2>/dev/null \
    || fail "SysTerm icon on disk is not the canonical >_ design (expected #6ddb73 in $ICON)"

# 4) The target bootloader is installable offline. grub must be INSTALLED in the
# live chroot so its .deb is in the ISO pool and already in the unpacked target;
# otherwise Calamares dies with "grub-efi-amd64 has no installation candidate"
# and "update-grub: No such file or directory". Assert both the arch grub-efi
# package and update-grub are actually here.
ARCH=$(dpkg --print-architecture 2>/dev/null || echo unknown)
case "$ARCH" in
    arm64) GRUB_PKG=grub-efi-arm64 ;;
    amd64) GRUB_PKG=grub-efi-amd64 ;;
    *)     GRUB_PKG=grub-efi-amd64 ;;
esac
dpkg-query -W -f='${Status}' "$GRUB_PKG" 2>/dev/null | grep -q 'install ok installed' \
    || fail "$GRUB_PKG not installed — Calamares cannot install GRUB into the target offline"
[ -x /usr/sbin/update-grub ] || fail "/usr/sbin/update-grub missing — grub-common not installed"
echo "sysible-verify: OK — $GRUB_PKG installed, update-grub present (target install can bootload)."

# 5) GDM greeter is de-Debianised: our login watermark is installed and wired as
# the login-screen logo (replacing "debian 12").
[ -f /usr/share/pixmaps/sysible-login-logo.png ] \
    || fail "Sysible login watermark missing (/usr/share/pixmaps/sysible-login-logo.png)"
grep -rqs "sysible-login-logo.png" /etc/dconf/db/gdm.d/ \
    || fail "GDM login-screen logo not pointed at the Sysible watermark"
echo "sysible-verify: OK — GDM login watermark installed and wired."

# 5b) The greeter must actually be painted. The watermark check above passes on
# a completely stock greeter, because the logo we wire in is a transparent 1x1
# PNG — the branding is the background, and nothing asserted the background.
# That is how 547444b shipped an unbranded greeter for two months.
if command -v gresource >/dev/null 2>&1; then
    gresource list /usr/share/gnome-shell/gnome-shell-theme.gresource 2>/dev/null \
        | grep -q 'sysible-login.png' \
        || fail "greeter background is not in the shell theme gresource — the login screen will be stock GNOME (run /usr/lib/sysible/brand-greeter)"
    echo "sysible-verify: OK — greeter background compiled into the shell theme."
fi

# 5c) THE DESKTOP MUST ACTUALLY COME UP BRANDED. Everything below was learned
# from one workstation that lost its dock, desktop icons and panel monitor for a
# day. Each check is a thing that was silently wrong and that nothing caught.

# The extension defaults must be a dconf SYSTEM DB keyfile. A gschema default
# does not survive: GNOME rewrites org.gnome.shell keys into the user db on
# session start and shadows it.
_EXT=/etc/dconf/db/local.d/05-sysible-extensions
[ -f "$_EXT" ] || fail "no dconf default for shell extensions ($_EXT) — the dock and desktop icons will not load"

# GNOME's master kill switch. When the shell flips this to true EVERY extension
# stops loading while still listing as enabled, and nothing tells the user. The
# default must say false explicitly so a fresh install and every new user start
# with extensions on.
grep -q '^disable-user-extensions=false' "$_EXT" \
    || fail "$_EXT does not set disable-user-extensions=false — one silent switch can strip the whole desktop"

# Every extension we enable must actually be installed, or we are enabling
# something that cannot load.
_MISSING=""
for _u in $(sed -n "s/^enabled-extensions=//p" "$_EXT" | tr -d "[]' " | tr ',' ' '); do
    [ -n "$_u" ] || continue
    [ -d "/usr/share/gnome-shell/extensions/$_u" ] \
        || [ -d "/usr/local/share/gnome-shell/extensions/$_u" ] \
        || _MISSING="$_MISSING $_u"
done
[ -z "$_MISSING" ] || fail "enabled but NOT installed:$_MISSING — these will never load"
echo "sysible-verify: OK — shell extensions enabled by default and all installed."

# dconf update must have run, or none of the keyfiles above are in effect.
[ -f /etc/dconf/db/local ] \
    || fail "/etc/dconf/db/local was never compiled — every dconf default in local.d is inert"

# The wallpaper the desktop defaults to has to exist. It is referenced by path,
# and a missing file gives a flat near-black desktop with no error anywhere.
for _k in picture-uri picture-uri-dark; do
    _w=$(sed -n "s/^$_k='file:\/\/\(.*\)'$/\1/p" /etc/dconf/db/local.d/00-sysible-desktop 2>/dev/null | head -1)
    [ -n "$_w" ] || continue
    [ -f "$_w" ] || fail "default wallpaper $_k points at $_w which is not in the image"
done
echo "sysible-verify: OK — default wallpapers present."

# 6) Branding integrity. Every logo in the image (GRUB boot menu, Plymouth,
# Calamares, GDM, app-grid) is rendered from ONE canonical mark
# (branding/logo/sysible-mark.svg) and its sha256 recorded in a manifest shipped
# into the image. Assert the on-disk files still match — this is what stops the
# GRUB boot logo from silently drifting back to old art while the dock icon is
# fixed. Env-independent: just sha256 of the committed bytes.
BMAN=/usr/share/sysible/branding.manifest
[ -f "$BMAN" ] || fail "branding manifest missing ($BMAN)"
PREFIX=live-build/config/includes.chroot
checked=0
while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    sha=${line%% *}
    rel=${line#* }
    rel=${rel# }
    # Only the assets that actually land in the installed root (under
    # includes.chroot); ISO-only splashes and repo README badges are skipped here
    # and covered by scripts/verify-branding.sh in CI instead.
    case "$rel" in
        "$PREFIX"/*) img="/${rel#"$PREFIX"/}" ;;
        *) continue ;;
    esac
    [ -f "$img" ] || fail "branded asset missing from image: $img"
    act=$(sha256sum "$img" 2>/dev/null | awk '{print $1}')
    [ "$act" = "$sha" ] || fail "branded asset drifted from the canonical mark: $img"
    checked=$((checked + 1))
done < "$BMAN"
[ "$checked" -gt 0 ] || fail "branding manifest matched no in-image assets"
echo "sysible-verify: OK — $checked branded assets match the canonical mark (incl. GRUB boot logo)."

# 7) The greeter must not be gated by our own units, and Plymouth must not be able
# to deadlock the live boot. Root cause of the "boots to a black screen with no
# login screen" hang: gdm.service is ordered After=plymouth-quit.service AND
# Conflicts= it, while plymouth-quit-wait.service runs `plymouth --wait` with
# TimeoutSec=0 (infinite). If plymouthd wedges on the panel, the wait never
# returns, multi-user.target never completes, graphical.target is never reached and
# GDM NEVER STARTS (journalctl -u gdm shows no entries at all) — yet a manual
# `systemctl start gdm3` works, because that bypasses the target dependency. The
# live boot requests no splash and never rebuilds the initramfs, so Plymouth adds
# nothing there; plymouth.enable=0 in the live cmdline removes the deadlock. The
# INSTALLED system is unaffected (it has its own cmdline via /etc/default/grub.d).
for _u in /usr/lib/systemd/system/sysible-avatar.service \
          /usr/lib/systemd/system/sysible-branding-guard.service; do
    [ -f "$_u" ] || continue
    ! grep -q '^Before=.*\(gdm\|display-manager\)' "$_u" \
        || fail "$_u is ordered Before=gdm — cosmetic branding must never gate the login screen"
done
echo "sysible-verify: OK — no Sysible unit gates the display manager."

# 8) The live user must be LOGINABLE-BY-AUTOLOGIN and carry NO usable credential.
# Second root cause of "GDM starts, graphical.target is reached, no session ever
# appears": 9100-sysible-users ran `chage -d 0 sysible`, which sets shadow's
# lstchg to 0 — "must change password at next login (root enforced)". GDM's
# autologin stack satisfies AUTH with pam_permit and consults pam_unix only in the
# ACCOUNT phase, which is exactly where that flag is enforced, so every boot
# logged "expired password for user sysible (root enforced)" followed by
# "conversation failed / user aborted password change". Autologin cannot run a
# password-change conversation, so the requirement was UNSATISFIABLE and the
# desktop never drew. Assert both halves so neither can regress:
#   * lstchg must NOT be 0 (not force-expired), or autologin is impossible;
#   * the password field MUST be locked ('!'/'*') and never a real hash or empty
#     — empty would be accepted by Debian's `pam_unix ... nullok`.
_LU=sysible
_shadow=$(getent shadow "$_LU" 2>/dev/null || true)
if [ -n "$_shadow" ]; then
    _pw=$(printf '%s' "$_shadow" | cut -d: -f2)
    _lstchg=$(printf '%s' "$_shadow" | cut -d: -f3)
    [ "$_lstchg" != "0" ] \
        || fail "live user '$_LU' is force-expired (lstchg=0) — GDM autologin cannot satisfy a password change, so the desktop will never appear. Do not use 'chage -d 0' here."
    case "$_pw" in
        "") fail "live user '$_LU' has an EMPTY password — Debian's pam_unix nullok would accept it. Lock it with 'passwd -l'." ;;
        '!'*|'*'*) : ;;   # locked: no password can ever match
        *) fail "live user '$_LU' ships a real password hash — never bake a credential into the image." ;;
    esac
    echo "sysible-verify: OK — live user '$_LU' is locked (no usable credential) and not force-expired."
else
    fail "live user '$_LU' is missing from the image"
fi

# 9) The live session must have a route to root and no lock screen.
# These are the consequences of section 8: the live account is LOCKED, so it can
# neither authenticate to sudo nor unlock a lock screen. Without a passwordless
# sudoers entry the live session has no way to become root at all; without the
# lock being disabled, closing a laptop lid suspends, GNOME locks on resume, and
# the session is unrecoverable. Both are set up by the live-config script below,
# which runs ONLY on a live boot — assert it ships, is executable, and that the
# sudoers line it writes actually parses. A malformed sudoers.d file does not
# degrade gracefully: sudo refuses to run at all, which would be a worse failure
# than the one this prevents.
_LC=/lib/live/config/2999-sysible-live-session
[ -f "$_LC" ] || fail "$_LC is missing — the live session would have no passwordless sudo and an unescapable lock screen"
[ -x "$_LC" ] || fail "$_LC is not executable, so live-config will not run it"
grep -q 'NOPASSWD' "$_LC" || fail "$_LC no longer grants the live user passwordless sudo"
grep -q 'lock-enabled=false' "$_LC" || fail "$_LC no longer disables the live lock screen"
# pkexec authenticates through polkit, which does NOT read sudoers — without this
# rule the installer raises a password dialog the locked live account can never
# answer, and the system cannot be installed at all.
grep -q 'polkit.addRule' "$_LC" || fail "$_LC no longer grants the live user the installer's polkit action — 'Install Sysible Workstation' would ask for a password that does not exist"
grep -q 'calamares' "$_LC" || fail "$_LC's polkit rule no longer mentions calamares"
grep -q 'subject.active' "$_LC" || fail "$_LC's polkit rule no longer requires a local ACTIVE session — it must not grant a remote or background caller"
# Both launchers must go through the wrapper, and the wrapper must keep BOTH
# routes to root. The polkit rule alone is a single point of failure — a rule that
# is not read, a different action id, a polkitd without JS rules, and the operator
# is back at an unanswerable password dialog with an ISO that cannot be installed.
# The wrapper's sudo fallback is what makes that impossible, so it is checked as
# hard as the rule itself.
_LAUNCH=/usr/local/bin/sysible-os-installer
[ -x "$_LAUNCH" ] || fail "$_LAUNCH is missing or not executable — the installer has no launcher"
grep -q 'pkexec' "$_LAUNCH" || fail "$_LAUNCH no longer tries pkexec (the supported path)"
grep -q 'sudo -E calamares' "$_LAUNCH" || fail "$_LAUNCH lost its sudo fallback — a polkit failure would leave the ISO uninstallable"
for _d in /usr/share/applications/install-sysible-workstation.desktop /usr/local/bin/sysible-live-installer; do
    [ -f "$_d" ] || fail "$_d is missing — the installer has no launcher"
    grep -q 'sysible-os-installer' "$_d" || fail "$_d does not start the installer through $_LAUNCH"
    grep -q 'pkexec calamares' "$_d" && fail "$_d still calls pkexec directly, bypassing the sudo fallback"
done
if command -v visudo >/dev/null 2>&1; then
    _t=$(mktemp)
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$_LU" > "$_t"
    visudo -c -f "$_t" >/dev/null 2>&1 || { rm -f "$_t"; fail "the sudoers line for '$_LU' does not parse — sudo would refuse to run"; }
    rm -f "$_t"
    echo "sysible-verify: OK — live sudoers line parses; lock screen disabled for the live session."
else
    echo "sysible-verify: OK — live-config session script present (visudo unavailable to parse-check)."
fi

# 10) The AI model feature must stay GONE.
# `sysible ai` / `sai`, the /etc/profile.d helper and the bundled Ollama runtime
# were removed on request. This asserts the IMAGE is actually free of them, not
# just the recipe: a hook that silently stopped applying, a stale file surviving
# in includes.chroot, or a package pulling ollama back in would otherwise ship a
# feature that was deliberately taken out — and a model server enabled at boot.
for _gone in /etc/profile.d/sysible-ai.sh /usr/local/bin/ollama \
             /etc/systemd/system/ollama.service; do
    [ -e "$_gone" ] && fail "$_gone is present, but the AI model feature was removed"
done
if command -v sysible >/dev/null 2>&1; then
    sysible --help 2>&1 | grep -qiw 'ai' \
        && fail "the 'sysible' CLI still offers an 'ai' subcommand"
fi
grep -rqs 'profile.d/sysible-ai.sh' /etc/bash.bashrc \
    && fail "/etc/bash.bashrc still sources the removed AI shell helper"
id ollama >/dev/null 2>&1 && fail "the 'ollama' service account is still in the image"
# The SysTerm companion pane is part of the same feature and is built from its
# own repo during this build, so check the INSTALLED package too — a stale .deb or
# a build that picked up an older branch would put the AI pane straight back.
if [ -d /usr/lib/python3 ]; then
    find /usr/lib/python3 -path '*systerm/atlas.py' 2>/dev/null | grep -q . \
        && fail "the SysTerm Atlas companion module is still installed"
fi
[ -e /etc/profile.d/systerm-atlas.sh ] && fail "SysTerm's Atlas shell hook is still installed"
echo "sysible-verify: OK — no AI model feature in the image (no sysible ai, no sai, no ollama)."

# 11) live-config must not be able to hang the boot forever.
# live-config.service is Type=oneshot before basic.target, and systemd gives a
# oneshot TimeoutStartSec=infinity by default — so a component that blocks leaves
# the machine on "A start job is running for live-config.service (… / no limit)"
# with no console and no way to read the log. The drop-in makes that failure
# survivable; assert it actually shipped, and that it sets a FINITE timeout
# (a drop-in that says "infinity" would be worse than none, because it looks
# like the guard is there).
LCD=/etc/systemd/system/live-config.service.d/10-sysible-no-endless-hang.conf
[ -f "$LCD" ] || fail "the live-config start-timeout drop-in is missing ($LCD)"
grep -Eq '^[[:space:]]*TimeoutStartSec=[0-9]' "$LCD" \
    || fail "$LCD does not set a finite TimeoutStartSec"
echo "sysible-verify: OK — live-config has a finite start timeout ($(grep -E '^[[:space:]]*TimeoutStartSec=' "$LCD" | tr -d ' '))."

# 12) The live-session component must live where live-config will find it, and be
# executable. live-config EXECUTES /lib/live/config/* (it does not source them),
# so a non-executable file is silently skipped and the live session quietly loses
# passwordless sudo, the installer's polkit rule and the no-lock-screen setting.
# /lib is a symlink to /usr/lib on merged-usr Debian, so check the real path.
LCC=/usr/lib/live/config/2999-sysible-live-session
[ -f "$LCC" ] || fail "the live-session live-config component is missing ($LCC)"
[ -x "$LCC" ] || fail "$LCC is not executable — live-config would skip it silently"
sh -n "$LCC" || fail "$LCC is not valid shell"
echo "sysible-verify: OK — live-session component present, executable and parses."

# 13) live-config must not generate SSH host keys during the boot.
# This image ships with NO host keys on purpose (9600 strips them), and
# live-config's 1160-openssh-server regenerates every missing one INSIDE
# live-config.service — which runs Before=basic.target with the oneshot default
# TimeoutStartSec=infinity. ssh-keygen blocks in getrandom() until the CRNG is
# up, and live-config is not ordered after systemd-random-seed, so on a host
# slow to gather entropy the whole boot stops there forever. The marker below
# makes that component skip itself; sysible-regenerate-ssh-host-keys.service
# does the job later, after basic.target. Assert the three facts that keep that
# true together — the marker, the absent keys, and the unit that replaces it —
# because any one of them alone is not enough.
# The two facts that depend on 9600-sysible-firstboot — no baked host keys, and
# the regen unit enabled — are asserted THERE, not here. Hooks run in lexical
# order, so this hook runs BEFORE 9600: checking them here made the keys check
# pass vacuously and the unit check fail outright (ISO run #33 died on it).
[ -f /var/lib/live/config/openssh-server ] \
    || fail "the live-config openssh-server skip marker is missing — live-config would generate host keys before basic.target"
# ...and the component's parting shot must not have landed either: it rewrites
# PasswordAuthentication to no, which is the opposite of what 9000 sets.
grep -Eq '^[[:space:]]*PasswordAuthentication[[:space:]]+yes' /etc/ssh/sshd_config \
    || fail "sshd_config does not enable PasswordAuthentication"
echo "sysible-verify: OK — live-config will not generate host keys at boot; sshd password auth enabled."

# 14) Every app-grid launcher must actually launch something, and every launcher
# script must define the helpers it calls.
#
# Both halves shipped broken. "Install Sysible SLOP" pointed at a script whose
# failure path called _warn, which nothing defined — under `set -eu` that is
# "command not found", exit 127, and the run died reporting nothing. A .desktop
# whose Exec has been renamed away is the same class of fault: the icon is there,
# the click does nothing, and the image builds green.
for _d in /usr/share/applications/*.desktop; do
    [ -f "$_d" ] || continue
    case "$(basename "$_d")" in sysible*|install-sysible*) ;; *) continue ;; esac
    _exec=$(sed -n 's/^Exec=//p' "$_d" | head -1 | awk '{print $1}')
    [ -n "$_exec" ] || fail "$_d has no Exec="
    command -v "$_exec" >/dev/null 2>&1 \
        || fail "$(basename "$_d") launches '$_exec', which is not on PATH in the image"
done
echo "sysible-verify: OK — every Sysible launcher's Exec resolves."

for _s in /usr/local/bin/install-sysible \
          /usr/local/bin/install-sysible-controller \
          /usr/local/bin/sysible-install /usr/local/bin/sysible-tools \
          /usr/local/bin/sysible-os-installer /usr/local/bin/sysible-live-installer; do
    [ -f "$_s" ] || continue
    # Check with the interpreter the script actually declares — sysible-tools is
    # bash and uses arrays, so `sh -n` reports a bogus syntax error on it and
    # would fail this build for no reason.
    case "$(head -1 "$_s")" in
        *bash) bash -n "$_s" || fail "$_s is not valid bash" ;;
        *)     sh   -n "$_s" || fail "$_s is not valid shell" ;;
    esac
    # Helpers called but never defined. Only leading-underscore names, which is
    # this codebase's convention for a script-local helper — an external command
    # never looks like that, so a hit is always a real missing definition.
    _defs=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*\(\)' "$_s" | tr -d '()' | sort -u)
    _calls=$(grep -oE '(^|[;&|] *|then |else |do )_[a-z_]+ ' "$_s" \
             | grep -oE '_[a-z_]+' | sort -u)
    for _c in $_calls; do
        printf '%s\n' "$_defs" | grep -qx "$_c" \
            || fail "$_s calls $_c but never defines it (set -eu makes that exit 127 mid-run)"
    done
done
echo "sysible-verify: OK — launcher scripts parse and define every helper they call."

# 15) ONE installer, and it must offer every product.
#
# There used to be three launchers — Controller, SLEP, SLOP — and the Controller
# one pointed at `install-sysible-controller`, a script that does not exist in the
# image. Check 14 catches that now, but the deeper problem was three entries for
# one script, each able to drift on its own. There is one launcher; assert it is
# the only one, that it starts the menu with no product baked into its Exec, and
# that the menu can actually install each product on its own.
_inst=$(ls /usr/share/applications/*install*.desktop 2>/dev/null \
        | grep -v install-sysible-workstation.desktop || true)
[ "$(printf '%s\n' "$_inst" | grep -c .)" -eq 1 ] \
    || fail "expected exactly ONE Sysible software installer launcher, found: $(printf '%s ' $_inst)"
[ -f /usr/share/applications/sysible-install.desktop ] \
    || fail "the consolidated installer launcher (sysible-install.desktop) is missing"
_e=$(sed -n 's/^Exec=//p' /usr/share/applications/sysible-install.desktop | head -1)
# The Exec may set environment for the run before naming the command — the
# launcher asks the installer to hold the terminal open (SYSIBLE_INSTALLER_PAUSE=1)
# so a Terminal=true window does not close on its own error message. Strip a
# leading `env` and any VAR=VALUE assignments; what is left must be the bare menu.
_cmd=$_e
case "$_cmd" in "env "*) _cmd=${_cmd#env } ;; esac
while :; do
    _w=${_cmd%% *}
    case "$_w" in *=*) ;; *) break ;; esac
    [ "$_cmd" != "$_w" ] || break     # one word left and it is an assignment: no command
    _cmd=${_cmd#* }
done
[ "$_cmd" = "install-sysible" ] \
    || fail "sysible-install.desktop should start the menu (Exec=[env VAR=VALUE ...] install-sysible), not '$_e'"
# ...and nothing in it may pick a product. The whole point of the one launcher is
# that the operator chooses from the menu; a product named anywhere in the Exec —
# command, argument or environment — is the three-launcher drift coming back.
case "$_e" in
    *controller*|*slep*|*connect*|*slop*)
        fail "sysible-install.desktop bakes a product into its Exec ('$_e') — the one launcher must open the menu and let the operator pick" ;;
esac
# If the launcher asks for the pause, the installer must still honour it. This is
# the guard f9b3b0c earned: without it every die() closes the terminal window on
# the explanation, and the operator sees a click that did nothing at all.
case "$_e" in
    *SYSIBLE_INSTALLER_PAUSE=1*)
        grep -q 'SYSIBLE_INSTALLER_PAUSE' /usr/local/bin/install-sysible \
            || fail "the launcher sets SYSIBLE_INSTALLER_PAUSE=1 but install-sysible no longer reads it — a Terminal=true run would close on its own error message" ;;
esac
for _p in controller slep connect slop; do
    grep -q "^      $_p)" /usr/local/bin/install-sysible \
        || grep -qE "(^|[^a-z])$_p\\b" /usr/local/bin/install-sysible \
        || fail "install-sysible does not offer '$_p' — the one installer must cover every product"
done
# The two older names must be aliases, not a second installer that can drift.
# install-sysible-controller in particular used to describe a pre-container
# layout that the Controller has not shipped for a long time.
for _a in /usr/local/bin/sysible-install /usr/local/bin/install-sysible-controller; do
    [ -f "$_a" ] || continue
    grep -q '^exec install-sysible\b' "$_a" \
        || fail "$_a must be a thin alias that execs install-sysible, not an installer of its own"
done
echo "sysible-verify: OK — one installer launcher, offering controller/slep/connect/slop."

# 16) Password-based SSH automation works out of the box.
# sshpass is in the metapackage's Depends, but nothing has ever asserted that
# anything in that list actually LANDED — the toolkit list is generated from it at
# build time and apt's output scrolls past. This one is worth pinning because its
# absence is invisible until the worst moment: Ansible does not degrade without
# it, it refuses ("you must install the sshpass program") on the first run against
# a host that has no key on it yet, which is the run that cannot go and fetch a
# missing package first.
command -v sshpass >/dev/null 2>&1 \
    || fail "sshpass is not in the image — Ansible cannot use a password over SSH, so bootstrapping a host that has no key yet fails at the first play"
echo "sysible-verify: OK — sshpass present (Ansible can bootstrap over a password)."

# 16b) A CONTAINER RUNTIME, and compose, are in the image.
# This is the one thing every Sysible product needs in order to run at all, and
# until now no verify step mentioned it. The chain that produced the bug report:
#
#   docker-ce is a Recommends (not a Depends) pulled from download.docker.com,
#   it is in the VEND exclusion list in build.sh so it never reaches the
#   generated toolkit list, and the vendor hook's apt-get install is the ONLY
#   thing that puts it in the image. Nothing then checked. So an ISO built while
#   that third-party repo was unreachable looked green, shipped, and the operator
#   found out at `install-sysible`.
#
# Assert the capability, not the brand: podman + podman-docker satisfies this as
# squarely as docker-ce does (the shim is /usr/bin/docker and the socket is
# symlinked), and the installer now installs either. What must never ship is an
# image with NEITHER.
command -v docker >/dev/null 2>&1 || command -v podman >/dev/null 2>&1 \
    || fail "no container runtime in the image (neither docker nor podman) — every Sysible product runs as a container, so install-sysible cannot do anything on this image"
_rt="$(command -v docker >/dev/null 2>&1 && echo docker || echo podman)"

# Compose is packaged separately from the engine on every path, so "the engine
# landed" does not mean a product can be brought up. sysiblectl looks for the v2
# plugin first and standalone docker-compose second; accept either, and
# podman-compose for a podman-only image.
_compose=none
for _c in /usr/libexec/docker/cli-plugins/docker-compose \
          /usr/lib/docker/cli-plugins/docker-compose \
          /usr/local/lib/docker/cli-plugins/docker-compose; do
    [ -x "$_c" ] && { _compose="docker compose (plugin)"; break; }
done
if [ "$_compose" = none ]; then
    if command -v docker-compose >/dev/null 2>&1; then _compose="docker-compose (standalone)"
    elif command -v podman-compose >/dev/null 2>&1; then _compose="podman-compose"
    fi
fi
[ "$_compose" != none ] \
    || fail "no compose implementation in the image (no docker compose plugin, no docker-compose, no podman-compose) — every product is brought up with compose"
echo "sysible-verify: OK — container runtime present ($_rt) with $_compose."

# 17) No Raspberry Pi bootloader firmware. raspi-firmware is NOT in any package
# list — it rides in as a Recommends of firmware-brcm80211, which ships the Pi's
# Wi-Fi blobs next to the laptop Broadcom ones we want. Its initramfs hook copies
# the kernel into /boot/firmware, which does not exist on this image, so it exits
# 1 and takes update-initramfs down with it. The first apt upgrade that brings a
# new kernel then leaves that kernel UNCONFIGURED, and every later apt run fails
# on the same package until someone fixes it by hand. 8200 purges it; this is the
# guarantee the purge actually ran, because the symptom only appears weeks later
# on somebody else's machine.
if dpkg-query -W -f='${Status}' raspi-firmware 2>/dev/null | grep -q 'install ok'; then
    fail "raspi-firmware is installed — its initramfs hook needs /boot/firmware and will leave the next kernel upgrade half-configured (hook 8200 should have purged it)"
fi
[ ! -e /etc/initramfs/post-update.d/z50-raspi-firmware ] \
    || fail "the raspi-firmware initramfs hook is still on disk — update-initramfs will fail on the next kernel"
echo "sysible-verify: OK — no Pi bootloader firmware (kernel upgrades will configure)."

# 18) NOTHING ELSE may slip code into the kernel-upgrade path either.
#
# raspi-firmware was not the bug. The bug was that a package nobody named could
# add a script that runs on every kernel upgrade on every installed machine, and
# no part of this build would notice. It stayed green here because at ISO build
# time the kernel is configured BEFORE the offending package unpacks its hook;
# the explosion waits for the first upgrade that ships a new kernel, weeks later
# and on someone else's workstation. The next Recommends to do this must not get
# the same free pass, so the kernel-upgrade path is pinned.

# flash-kernel first, because it is the arm64 twin of raspi-firmware and it
# deserves its own sentence rather than the generic one below. It writes the
# kernel to a board-specific boot partition or U-Boot location; Sysible
# Workstation boots GRUB/UEFI on arm64 (see the bootloader split in build.sh),
# so it can only break upgrades here.
if dpkg-query -W -f='${Status}' flash-kernel 2>/dev/null | grep -q 'install ok'; then
    fail "flash-kernel is installed. Like raspi-firmware it writes the kernel to a
    board-specific boot location and will leave kernel upgrades half-configured on
    this GRUB/UEFI image. Purge it in a chroot hook next to 8200, or — if arm64
    genuinely needs it — say so here and explain why."
fi

# /etc/initramfs/post-update.d/ is EMPTY on a stock GRUB/UEFI Debian. It exists
# for images that chain-load through firmware or a U-Boot blob — raspi-firmware,
# flash-kernel, u-boot-tools — none of which describes this image on either arch.
_pu=$(ls -A /etc/initramfs/post-update.d 2>/dev/null || true)
[ -z "$_pu" ] || fail "unexpected initramfs post-update hook(s): $_pu — these run on
    every kernel upgrade of every installed machine, and on a GRUB/UEFI image they
    copy the kernel to a boot partition that does not exist, leaving the new kernel
    unconfigured and apt broken until someone fixes it by hand. Purge the package
    in a chroot hook (see 8200-sysible-no-pi-firmware), or if it is genuinely
    wanted, say so here."

# /etc/kernel/postinst.d/ legitimately has a few. Pin the known-good set so a new
# arrival is a decision somebody made, not one a Recommends made for them.
for _h in /etc/kernel/postinst.d/*; do
    [ -e "$_h" ] || continue
    case "${_h##*/}" in
        apt-auto-removal|dkms|initramfs-tools|zz-update-grub) ;;
        *) fail "unexpected kernel postinst hook: ${_h##*/} — it will run on every
    kernel upgrade of every installed machine. If it belongs here, add it to the
    allowlist in this check and say why; otherwise purge the package that shipped
    it." ;;
    esac
done
echo "sysible-verify: OK — nothing unexpected runs on a kernel upgrade."

echo "sysible-verify: OK — SysTerm $V, Run Command menu, and new icon all present."
