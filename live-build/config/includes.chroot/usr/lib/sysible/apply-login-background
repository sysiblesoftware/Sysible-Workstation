#!/bin/sh
# Paint the Sysible login/lock background into the GNOME Shell theme gresource.
# The greeter on Debian ignores the desktop-background gsetting, so the reliable
# method is to rebuild gnome-shell-theme.gresource with our #lockDialogGroup
# style. That gresource is OWNED by gnome-shell-common, so a gnome-shell upgrade
# reverts it — this script is therefore called BOTH at build time and by the
# branding guard after upgrades. Idempotent + cheap: if our marker is already in
# the gresource, do nothing.
set -e
GRES=/usr/share/gnome-shell/gnome-shell-theme.gresource
LOGIN_BG=/usr/share/backgrounds/sysible/sysible-login.png

command -v gresource >/dev/null 2>&1 || exit 0
[ -f "$GRES" ] && [ -f "$LOGIN_BG" ] || exit 0
# Already branded? (marker = our login image compiled into the resource)
if gresource list "$GRES" 2>/dev/null | grep -q 'sysible-login.png'; then
    exit 0
fi
command -v glib-compile-resources >/dev/null 2>&1 || exit 0

WORK=$(mktemp -d)
ok=1
for res in $(gresource list "$GRES" 2>/dev/null); do
    rel=${res#/org/gnome/shell/theme/}
    mkdir -p "$WORK/$(dirname "$rel")"
    gresource extract "$GRES" "$res" > "$WORK/$rel" 2>/dev/null || ok=0
done
if [ "$ok" = 1 ]; then
    cp "$LOGIN_BG" "$WORK/sysible-login.png"
    for css in gnome-shell.css gnome-shell-dark.css gnome-shell-light.css \
               gnome-shell-high-contrast.css gdm.css gdm3.css; do
        [ -f "$WORK/$css" ] || continue
        cat >> "$WORK/$css" <<'CSS'

/* Sysible lock / login background */
#lockDialogGroup {
  background: #0a0d13 url('resource:///org/gnome/shell/theme/sysible-login.png');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
}
CSS
    done
    {
        echo '<?xml version="1.0" encoding="UTF-8"?>'
        echo '<gresources><gresource prefix="/org/gnome/shell/theme">'
        ( cd "$WORK" && find . -type f ! -name 'sysible.gresource.xml' \
            | sed 's|^\./||' | sort | while read -r f; do echo "  <file>$f</file>"; done )
        echo '</gresource></gresources>'
    } > "$WORK/sysible.gresource.xml"
    ( cd "$WORK" && glib-compile-resources --sourcedir="$WORK" \
        --target="$GRES" sysible.gresource.xml ) 2>/dev/null \
        && echo "sysible: login background applied" \
        || echo "sysible: gresource rebuild skipped"
fi
rm -rf "$WORK"
