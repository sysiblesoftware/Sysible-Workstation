#!/bin/sh
# Load the platform's prebuilt container images into the local Docker store.
#
# The ISO carries every finished service image, built in CI where there is a
# network and a builder (see the app-images job in iso.yml). They are useless
# sitting in /usr/share as a tarball -- compose looks in the image store -- so
# this loads them once, as early as the daemon allows.
#
# This is what makes an airgapped install work. Building on the host could never
# be made to: every service's Dockerfile fetches from PyPI, npm, Debian or
# Alpine, so a host that cannot reach those cannot build the platform no matter
# how many base images ship with it.
#
# Idempotent twice over: `docker load` of an image already present is a cheap
# no-op, and the marker stops this repeating on every boot.
set -e
DIR=/usr/share/sysible/app-images
MARK=/var/lib/sysible/platform-images-loaded
LOG=/var/log/sysible-platform-images.log

[ -d "$DIR" ] || exit 0
[ -f "$MARK" ] && exit 0
command -v docker >/dev/null 2>&1 || exit 0
# No daemon yet is not a failure: the unit is ordered after docker.service, and a
# manual run before it is up should simply do nothing rather than report a fault.
docker info >/dev/null 2>&1 || exit 0

mkdir -p "$(dirname "$MARK")" 2>/dev/null || true
exec >>"$LOG" 2>&1
echo "=== sysible platform images: $(date -u 2>/dev/null) ==="

loaded=0 failed=0
for tar in "$DIR"/*.tar; do
    [ -f "$tar" ] || continue
    if docker load -i "$tar"; then
        loaded=$((loaded + 1))
    else
        failed=$((failed + 1))
        echo "WARNING: could not load $tar"
    fi
done

echo "loaded=$loaded failed=$failed"
# Only claim it is done if nothing failed; a partial load should be retried on
# the next boot rather than remembered as complete.
if [ "$failed" -eq 0 ] && [ "$loaded" -gt 0 ]; then
    date -u > "$MARK" 2>/dev/null || true
    echo "=== done ==="
else
    echo "=== incomplete — will retry on the next boot ==="
fi
exit 0
