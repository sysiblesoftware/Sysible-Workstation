#!/bin/sh
# Sysible branding guard. Some of our branding lives in files that Debian
# packages OWN, so an `apt upgrade` (or unattended-upgrades) can quietly revert
# it. This script re-asserts those pieces. It runs on every boot (a systemd
# oneshot) AND after every dpkg/apt transaction (an apt Post-Invoke hook), so
# drift is corrected immediately. Every step is idempotent and cheap when nothing
# changed — safe to run as often as apt does.
set -e
[ "$(id -u)" = 0 ] || exit 0

# 1) os-release — base-files upgrades rewrite /usr/lib/os-release back to Debian.
want='PRETTY_NAME="Sysible Workstation — Engineering Automation Cloud"'
if ! grep -q "$want" /usr/lib/os-release 2>/dev/null && \
   ! grep -q "$want" /etc/os-release 2>/dev/null; then
    cat > /usr/lib/os-release <<'OSREL'
PRETTY_NAME="Sysible Workstation — Engineering Automation Cloud"
NAME="Sysible Workstation"
ID=sysible
ID_LIKE=debian
VERSION="0.1 (Ignition)"
VERSION_ID="0.1"
VERSION_CODENAME=ignition
HOME_URL="https://sysible.com"
SUPPORT_URL="https://sysible.com/controller"
LOGO=sysible-logo
OSREL
    [ -e /etc/os-release ] && [ ! -L /etc/os-release ] && cp /usr/lib/os-release /etc/os-release
    echo "sysible-guard: os-release re-branded"
fi

# 2) GDM greeter branding — safe dconf-based re-assert only. We no longer rebuild
#    the gnome-shell theme gresource (that was the non-stock delta that could wedge
#    the greeter on some GPUs); apply-login-background is now a boot-safe stub that
#    just re-runs `dconf update` so the gdm profile (logo removal, background hint)
#    stays authoritative after an upgrade.
[ -x /usr/lib/sysible/apply-login-background ] && /usr/lib/sysible/apply-login-background || true

# 2b) Greeter background. gnome-shell-common OWNS the theme gresource, so any
#     gnome-shell upgrade reverts it and the greeter silently goes stock. Only
#     re-apply on machines that opted in — brand-greeter leaves the marker — and
#     only when the resource has actually gone back to stock. brand-greeter is
#     itself safe: it builds to a temp file, validates, and never touches the
#     live resource on failure.
if [ -f /etc/sysible/greeter-branding ] && [ -x /usr/lib/sysible/brand-greeter ] \
   && command -v gresource >/dev/null 2>&1 \
   && ! gresource list /usr/share/gnome-shell/gnome-shell-theme.gresource 2>/dev/null \
        | grep -q 'sysible-login.png'; then
    /usr/lib/sysible/brand-greeter || echo "sysible-guard: greeter re-brand failed (greeter left stock)"
fi

# 2c) GNOME's extension kill switch. If the shell flipped it, the desktop has
#     silently lost its dock, desktop icons and panel monitor, and nothing says
#     so. We do NOT flip it back: GNOME sets it to break a crash loop, and
#     overriding that from a boot hook could pin a user in one. We make it
#     visible, with the one line that fixes it.
for _rd in /run/user/*; do
    [ -d "$_rd" ] || continue
    _uid=$(basename "$_rd")
    case "$_uid" in ''|*[!0-9]*) continue ;; esac
    [ "$_uid" -ge 1000 ] || continue
    _usr=$(getent passwd "$_uid" | cut -d: -f1) || continue
    [ -n "$_usr" ] && [ -S "$_rd/bus" ] || continue
    _off=$(runuser -u "$_usr" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$_rd/bus" \
           gsettings get org.gnome.shell disable-user-extensions 2>/dev/null) || continue
    if [ "$_off" = "true" ]; then
        _m="sysible-guard: GNOME has disabled ALL shell extensions for '$_usr'
sysible-guard: (org.gnome.shell disable-user-extensions = true). The dock,
sysible-guard: desktop icons and the panel monitor will not load, and every
sysible-guard: extension reports INITIALIZED instead of ACTIVE. GNOME sets this
sysible-guard: by itself after it thinks an extension hung the shell. To undo:
sysible-guard:     gsettings set org.gnome.shell disable-user-extensions false
sysible-guard: then log out and back in."
        echo "$_m" >&2
        command -v logger >/dev/null 2>&1 && \
            echo "$_m" | logger -t sysible-desktop -p daemon.warning 2>/dev/null || true
    fi
done

# 3) GRUB entry titles — grub-common upgrades restore the stock 10_linux, turning
#    "Sysible Workstation" back into "Sysible GNU/Linux". Re-apply the one-line patch,
#    and only regenerate grub.cfg if we actually changed something.
if [ -f /etc/grub.d/10_linux ] && \
   grep -q '${GRUB_DISTRIBUTOR} GNU/Linux' /etc/grub.d/10_linux; then
    sed -i 's|${GRUB_DISTRIBUTOR} GNU/Linux|${GRUB_DISTRIBUTOR} Linux|g' /etc/grub.d/10_linux
    command -v update-grub >/dev/null 2>&1 && update-grub >/dev/null 2>&1 || true
    echo "sysible-guard: GRUB titles re-patched"
fi

# 4) Plymouth boot splash default (alternatives-based; survives most upgrades, but
#    re-assert if something else grabbed it). No -R here: initramfs is rebuilt by
#    the triggering transaction.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    cur=$(plymouth-set-default-theme 2>/dev/null || echo "")
    [ "$cur" = sysible ] || plymouth-set-default-theme sysible 2>/dev/null || true
fi

# 5) Refresh the GDM dconf db (logo override etc.) — cheap, keeps it authoritative.
command -v dconf >/dev/null 2>&1 && dconf update 2>/dev/null || true

exit 0
