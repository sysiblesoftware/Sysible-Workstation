#!/bin/sh
# Sysible branding guard. Some of our branding lives in files that Debian
# packages OWN, so an `apt upgrade` (or unattended-upgrades) can quietly revert
# it. This script re-asserts those pieces. It runs on every boot (a systemd
# oneshot) AND after every dpkg/apt transaction (an apt Post-Invoke hook), so
# drift is corrected immediately. Every step is idempotent and cheap when nothing
# changed — safe to run as often as apt does.
set -e
[ "$(id -u)" = 0 ] || exit 0

# 1) os-release — base-files upgrades rewrite /usr/lib/os-release back to Debian.
want='PRETTY_NAME="Sysible Workstation"'
if ! grep -q "$want" /usr/lib/os-release 2>/dev/null && \
   ! grep -q "$want" /etc/os-release 2>/dev/null; then
    cat > /usr/lib/os-release <<'OSREL'
PRETTY_NAME="Sysible Workstation"
NAME="Sysible Workstation"
ID=sysible
ID_LIKE=debian
VERSION="0.1 (Ignition)"
VERSION_ID="0.1"
VERSION_CODENAME=ignition
HOME_URL="https://sysible.com"
SUPPORT_URL="https://sysible.com/controller"
LOGO=sysible-logo
OSREL
    [ -e /etc/os-release ] && [ ! -L /etc/os-release ] && cp /usr/lib/os-release /etc/os-release
    echo "sysible-guard: os-release re-branded"
fi

# 2) GDM login background — gnome-shell-common upgrades overwrite the gresource.
[ -x /usr/lib/sysible/apply-login-background ] && /usr/lib/sysible/apply-login-background || true

# 3) GRUB entry titles — grub-common upgrades restore the stock 10_linux, turning
#    "Sysible Workstation" back into "Sysible GNU/Linux". Re-apply the one-line patch,
#    and only regenerate grub.cfg if we actually changed something.
if [ -f /etc/grub.d/10_linux ] && \
   grep -q '${GRUB_DISTRIBUTOR} GNU/Linux' /etc/grub.d/10_linux; then
    sed -i 's|${GRUB_DISTRIBUTOR} GNU/Linux|${GRUB_DISTRIBUTOR} Linux|g' /etc/grub.d/10_linux
    command -v update-grub >/dev/null 2>&1 && update-grub >/dev/null 2>&1 || true
    echo "sysible-guard: GRUB titles re-patched"
fi

# 4) Plymouth boot splash default (alternatives-based; survives most upgrades, but
#    re-assert if something else grabbed it). No -R here: initramfs is rebuilt by
#    the triggering transaction.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    cur=$(plymouth-set-default-theme 2>/dev/null || echo "")
    [ "$cur" = sysible ] || plymouth-set-default-theme sysible 2>/dev/null || true
fi

# 5) Refresh the GDM dconf db (logo override etc.) — cheap, keeps it authoritative.
command -v dconf >/dev/null 2>&1 && dconf update 2>/dev/null || true

exit 0
