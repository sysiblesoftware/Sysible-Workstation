#!/bin/sh
# sync-sha256: 7b2d40b9cf8a75da963526e7f3d4b1f29fda9c0c6d80884805bbb837655642e4
# sysible-hint — one line, at login, about the Sysible software on this machine.
#
# Two things an operator otherwise has to already know:
#   * nothing is installed yet, and `install-sysible` is how to change that. On
#     Workstation that is an app-grid icon; on Server there is no app grid, so
#     without this the installer simply is not discoverable.
#   * an installed product is behind its release. Updates are not automatic —
#     `sysiblectl update all` rebuilds from source and recreates containers, which
#     is not something to do behind someone's back — so the machine has to SAY so.
#
# NEVER touches the network: it reads the state file sysible-release-check leaves
# behind on a timer. A login must not wait on a git remote.
#
# Silent when there is nothing to say, and switched off for good with
#   touch ~/.sysible-no-hints       (just me)
#   sudo touch /etc/sysible/no-hints  (this machine)
#
# Shipped byte-identical on Sysible Workstation and Sysible Server. Regenerate the
# stamp above with: python tests/stamp_sync.py
set -eu

SRC_DIR="${SYSIBLE_SRC_DIR:-/opt/sysible-src}"
STATE="${SYSIBLE_STATE_DIR:-/var/lib/sysible}/update-state"
ETC="${SYSIBLE_ETC_DIR:-/etc/sysible}"

[ -f "$ETC/no-hints" ] && exit 0
[ -n "${HOME:-}" ] && [ -f "$HOME/.sysible-no-hints" ] && exit 0

# Colour only on a terminal that wants it.
if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
  # BUILT WITH printf, not stored as raw ESC bytes. These were literal
  # '[32m' / '[1m' / '[0m' -- the ESC (0x1B) that makes them escape
  # sequences was missing from the file, so every line of the banner
  # printed its own control codes as text:
  #
  #     [1m[32mSysible SLOP is set up on this machine.[0m
  #
  # A raw control byte in source is exactly the thing an editor, a copy
  # or a sanitiser silently eats, which is how it was lost. Generating it
  # at run time cannot be lost that way, and a test now checks the
  # rendered output rather than the source text.
  G=$(printf '\033[32m'); B=$(printf '\033[1m'); R=$(printf '\033[0m')
else
  G=''; B=''; R=''
fi

_installed() {
  for d in "$SRC_DIR"/*/; do
    [ -d "$d/.git" ] && return 0
  done
  return 1
}

# Chosen during the install, still pending or given up on. Without this the
# operator picks "slop" in the installer, the first-boot run fails on a network
# it could not reach, and the machine then says only "No Sysible software is
# installed" -- which reads as though nothing was ever asked for.
if [ -s "$ETC/apps.wanted" ] && ! _installed; then
  printf '\n%s%sThe Sysible apps you chose during the install have not finished setting up.%s\n' "$B" "$G" "$R"
  printf '  Chosen: %s%s%s — it retries on the next boot.\n' "$B" "$(tr -d ' \n' < "$ETC/apps.wanted")" "$R"
  printf '  Why it has not: %s/var/log/sysible-apps-firstboot.log%s\n' "$B" "$R"
  printf '  Or do it now:   %ssudo install-sysible%s\n\n' "$B" "$R"
  exit 0
fi
if [ -s "$ETC/apps-failed" ] && ! _installed; then
  printf '\n%s%sThe Sysible apps you chose during the install could not be set up.%s\n' "$B" "$G" "$R"
  printf '  Chosen: %s%s%s — it gave up after several tries.\n' "$B" "$(tr -d ' \n' < "$ETC/apps-failed")" "$R"
  printf '  Why:          %s/var/log/sysible-apps-firstboot.log%s\n' "$B" "$R"
  printf '  Try again:    %ssudo install-sysible%s\n\n' "$B" "$R"
  exit 0
fi

# Set up, and nothing has said how to reach it.
#
# The installer offers the Sysible apps during the install; the work then happens
# unattended on the first networked boot. SLOP's IdP prints its bootstrap account
# into a CONTAINER log, which an operator sitting at this console never sees. So a
# machine comes up serving a web front door and nothing anywhere on it says what
# the account is.
#
# Reported as "sysible/sysible isn't the default password for slop". The password
# is right; the username is `admin`. That is a documented, public credential, so
# printing it on the machine's own console costs nothing and answers the question
# the operator actually has.
#
# No network: `ip route get` reads the kernel routing table, it does not send
# anything.
if [ -s "$ETC/apps-installed" ] && _installed; then
  case " $(tr -d '\n' < "$ETC/apps-installed") " in
    *slop*)
      _ip="$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n1)"
      printf '\n%s%sSysible SLOP is set up on this machine.%s\n' "$B" "$G" "$R"
      printf '  Open:       %shttps://%s/%s\n' "$B" "${_ip:-<this-host>}" "$R"
      printf '  Sign in:    %sadmin%s / %ssysible%s  — the shipped default, and it is public.\n' \
             "$B" "$R" "$B" "$R"
      printf '  Change it:  at %s/account%s the first time you sign in.\n' "$B" "$R"
      printf '  Hide this:  %ssudo rm /etc/sysible/apps-installed%s\n\n' "$B" "$R"
      ;;
  esac
fi

if ! _installed; then
  printf '\n%s%sNo Sysible software is installed on this machine yet.%s\n' "$B" "$G" "$R"
  printf '  Install it with:  %ssudo install-sysible%s\n' "$B" "$R"
  printf '  (Controller, Engineering Platform and Connect, individually or all\n'
  printf '   behind one sign-in. Nothing runs and no ports open until you do.)\n\n'
  exit 0
fi

[ -f "$STATE" ] || exit 0
behind="$(sed -n 's/^behind=//p' "$STATE" | tail -n1)"
[ -n "${behind:-}" ] || exit 0

n=0
for _ in $behind; do n=$((n+1)); done
[ "$n" -gt 0 ] || exit 0
s=''; [ "$n" -eq 1 ] || s='s'
printf '\n%s%s%d Sysible product%s ha%s an update available%s: %s\n' \
  "$B" "$G" "$n" "$s" "$([ "$n" -eq 1 ] && echo s || echo ve)" "$R" "$behind"
printf '  Apply it with:  %ssudo sysiblectl update all%s   (or one at a time:\n' "$B" "$R"
printf '  sudo sysiblectl update <product>). Data volumes are never touched.\n\n'
