#!/bin/sh
# install-sysible-controller — compatibility alias for `install-sysible controller`.
#
# This used to be its own installer, and a stale one: it described a pre-container
# layout (/opt/sysible, a systemd backend + web console) that the Controller has
# not shipped for some time, so anyone who ran it got a different — and wrong —
# install from the one the desktop launcher performs.
#
# The suite now has exactly ONE installer, `install-sysible`, which installs any
# subset (controller, slep, connect) or all of them behind the SLOP front door.
# The old name survives only so it still does the right thing.
exec install-sysible controller "$@"
