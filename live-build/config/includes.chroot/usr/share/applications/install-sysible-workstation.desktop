[Desktop Entry]
Type=Application
Version=1.0
Name=Install Sysible Workstation
GenericName=System Installer
Comment=Install Sysible Workstation to your hard disk
Exec=sysible-os-installer
Icon=sysible-install
Terminal=false
Categories=System;
Keywords=install;installer;calamares;system;disk;
StartupNotify=true
# The running window is Calamares (WM_CLASS "calamares"). Bind it to this launcher
# so the dock/app-switcher shows the crisp themed "sysible-install" icon instead of
# Calamares' own low-res window icon (which renders pixelated at dock size).
StartupWMClass=calamares
