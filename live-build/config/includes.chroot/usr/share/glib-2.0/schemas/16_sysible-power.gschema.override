# Keep the session responsive — a VM/desktop shouldn't appear to "freeze" after
# idle. Disable automatic suspend and screen blanking. The screen LOCK stays
# enabled for security: manual lock (Super+L) and lock-on-suspend still protect
# an unattended machine; we only stop the idle blank/dim/auto-suspend on top of
# the systemd sleep-target mask in the system hook.
[org.gnome.settings-daemon.plugins.power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=0
idle-dim=false

[org.gnome.desktop.session]
idle-delay=uint32 0

[org.gnome.desktop.screensaver]
# Don't auto-activate the screensaver on idle (that's the "freeze" complaint),
# but KEEP lock-enabled so Super+L and lock-on-suspend still lock the session.
idle-activation-enabled=false
lock-enabled=true
