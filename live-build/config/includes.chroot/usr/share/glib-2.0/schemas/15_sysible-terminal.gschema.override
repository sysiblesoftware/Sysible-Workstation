[org.gnome.shell]
enabled-extensions=['ding@rastersoft.com', 'dash-to-dock@micxgx.gmail.com']
# NOTE: the dock's favorite-apps is defined ONCE, in the dconf system-db at
# /etc/dconf/db/local.d/00-sysible-desktop (which wins over any gschema default),
# so it is intentionally NOT set here. Keeping a second copy in a gschema drifted
# the two lists apart (this one pinned the un-installed 'code.desktop' and a
# different SysTerm id, yielding blank dock tiles). Single source of truth only.

[org.gnome.desktop.default-applications.terminal]
exec='systerm'
exec-arg='-e'

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
intellihide=false
# The dock pins only the five apps in favorite-apps (SysTerm, Firefox, VS Code,
# Text Editor, Files). The "Show Applications" grid button gives access to
# everything else, so keep it on and put it at the end of the dock.
show-show-apps-button=true
show-apps-at-top=false
show-trash=false
show-mounts=false
custom-theme-shrink=true
transparency-mode='FIXED'
background-opacity=0.85
custom-background-color=true
background-color='#0d1117'
