# Sysible fail2ban defaults. SSH is ON by default on Sysible and accepts password
# logins, so this jail is active out of the box: it watches the systemd journal and
# bans a source after too many failed logins (5 tries in 10m -> 1h ban).
[DEFAULT]
backend = systemd
bantime = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
