# Sysible Workstation — Calamares branding
---
componentName:  sysible

welcomeStyleCalamares:   false
welcomeExpandingLogo:    true

windowExpanding:    normal
windowSize:         800px,520px
windowPlacement:    center

strings:
    productName:         Sysible Workstation
    shortProductName:    Sysible Workstation
    version:             0.1
    shortVersion:        0.1
    versionedName:       Sysible Workstation 0.1 (Ignition)
    shortVersionedName:  Sysible Workstation 0.1
    bootloaderEntryName: Sysible Workstation
    productUrl:          https://sysible.com/
    supportUrl:          https://sysible.com/
    knownIssuesUrl:      https://sysible.com/
    releaseNotesUrl:     https://sysible.com/
    donateUrl:           https://sysible.com/

images:
    productLogo:         "install-logo.png"
    productIcon:         "install-logo.png"
    productWelcome:      "sysible-welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   sidebarBackground:    "#0d1117"
   sidebarText:          "#e6edf3"
   # Current step: WHITE text on the brand-blue highlight bar (was blue-on-blue,
   # which made the active step's label vanish).
   sidebarTextSelect:    "#ffffff"
   sidebarTextHighlight: "#5580ee"
