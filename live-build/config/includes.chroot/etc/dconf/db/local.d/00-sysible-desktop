# Sysible desktop defaults (system db → authoritative default for every user;
# a gschema default for org.gnome.shell was being overridden by GNOME's own
# session write, so the dock reverted to Firefox/Files/Software/Help).
[org/gnome/shell]
favorite-apps=['org.gnome.TextEditor.desktop', 'codium.desktop', 'systerm.desktop', 'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'com.giuspen.cherrytree.desktop']
# enabled-extensions now lives in the sysible-desktop-gnome package
# (/etc/dconf/db/local.d/05-sysible-extensions) so apt can add new ones — it
# sorts after this file, so it is the authoritative list (incl. the system monitor).

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
intellihide=false
show-show-apps-button=true
show-apps-at-top=false
show-trash=false
show-mounts=false
# Free Super+1..9 (dash-to-dock binds them to dock apps by default) so they drive
# workspace switching instead — see 10-sysible-workspaces.
hot-keys=false
custom-theme-shrink=true
transparency-mode='FIXED'
background-opacity=0.85
custom-background-color=true
background-color='#0d1117'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'

# Wallpaper fit mode. 'zoom' fills the screen preserving aspect (crop, never
# distort). GNOME's session was shadowing the gschema default, so on wide/
# fullscreen displays the 16:9 art rendered 'spanned'/'stretched' and looked
# distorted. Set it here (authoritative system db) and LOCK only the fit mode
# (see locks/20-sysible-background) — picture-uri stays unlocked so users can
# still change the wallpaper image, they just can't un-zoom it into a stretch.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/sysible/sysible-topographic-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/sysible/sysible-topographic.jpg'
picture-options='zoom'

# THE LOCK SCREEN IS THE DESKTOP WALLPAPER. There is nothing to set here.
#
# This block used to carry picture-options='zoom' and it did nothing at all.
# GNOME Shell 43 builds the unlock dialog's background with a BackgroundManager
# that is given no settingsSchema, so it falls back to the module default —
# org.gnome.desktop.background — and reads picture-uri-dark from there because
# color-scheme is prefer-dark above (gnome-shell 43, js/ui/unlockDialog.js and
# js/ui/background.js). org.gnome.desktop.screensaver still HAS a picture-uri
# key, which is exactly the trap: setting it looks like configuring the lock
# screen and changes nothing.
#
# What the lock screen does to that wallpaper is a BlurEffect at sigma 60
# (times the UI scale factor) and brightness 0.55. A 60-pixel blur erases fine
# linework, which is what these styles are made of — measured on the shipped
# set, topographic/neural/roads came out at a mean luminance of 8-10 out of
# 255, i.e. a black screen with a clock on it. The wallpapers now carry wide,
# low-amplitude brand blooms under the art for exactly this reason; see
# add_lock_blooms() in branding/wallpapers/render_wallpapers.py. The fix lives
# in the artwork because the artwork is the only thing the lock screen reads.
#
# The keys the lock screen DOES read from this schema are lock-enabled,
# lock-delay and user-switch-enabled. The installed system keeps GNOME's
# defaults for them; the live session disables locking (see the live-config
# dconf, which 9500-sysible-verify asserts).
