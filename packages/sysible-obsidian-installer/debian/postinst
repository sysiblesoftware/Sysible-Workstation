#!/bin/sh
set -e

# Do NOT install Obsidian from here. This postinst runs while dpkg is mid-
# transaction — during the live-build ISO chroot AND during Calamares' package
# step — and sysible-install-obsidian shells out to `apt-get install` on the
# downloaded .deb. That nested, non-reentrant dpkg call corrupts the parent run
# and aborts it with "Sub-process /usr/bin/dpkg returned an error code (1)" (it
# only bit when the download actually succeeded, which is why it was intermittent).
#
# Instead the #DEBHELPER# snippet below enables sysible-obsidian-installer.service,
# a first-boot oneshot that fetches + installs Obsidian once the system is up, dpkg
# is idle, and the network is online — and self-disables when done. That's the only
# safe place to run apt from. See usr/bin/sysible-install-obsidian.
#DEBHELPER#

exit 0
