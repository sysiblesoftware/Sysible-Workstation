#!/bin/sh
# The installer entry points used to ship ONLY inside the ISO, in
# live-build/config/includes.chroot/usr/local/bin. Nothing in a package owned
# them, so no `apt upgrade` could ever replace them: every fix reached new
# images only, and the machine that most needed one — already installed, whose
# operator had just hit the bug — kept the broken copy forever. That is the same
# failure this project has now had three times (guest agents, greeter branding,
# and the installer itself).
#
# ALL THREE names matter, not just the canonical one. `sysible-install` is how
# Sysible Server is installed, and `install-sysible-controller` is the old name
# that is still in runbooks; both are thin aliases that exec install-sysible, so
# a stale alias is harmless in itself — but a stale REGULAR FILE at any of these
# paths outranks /usr/sbin on root's PATH, and the one at
# /usr/local/bin/install-sysible would shadow the packaged installer no matter
# how many times apt updated it. So each is taken over the same way.
set -e

NAMES="install-sysible sysible-install install-sysible-controller"

case "$1" in
  configure)
    mkdir -p /usr/local/bin
    for n in $NAMES; do
      target="/usr/sbin/$n"
      link="/usr/local/bin/$n"
      [ -x "$target" ] || continue
      if [ -L "$link" ]; then
        # Already a link: repoint it in case an older layout aimed it elsewhere.
        ln -sfn "$target" "$link"
      elif [ -e "$link" ]; then
        # A real file from an older ISO. Keep one copy for an operator who wants
        # to diff, then get it out of the way.
        mkdir -p /var/backups/sysible
        cp -a "$link" "/var/backups/sysible/$n.pre-$(date -u +%Y%m%d%H%M%S)" || true
        rm -f "$link"
        ln -sfn "$target" "$link"
        echo "sysible-cli: replaced the ISO's $link with a link to $target," >&2
        echo "             so apt can keep it current from now on." >&2
      else
        ln -sfn "$target" "$link"
      fi
    done
    ;;
esac

#DEBHELPER#
exit 0
