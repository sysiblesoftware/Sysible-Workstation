#!/bin/sh
# Remove the compatibility links on the way out, but only where one still points
# at us — never a file or link the operator has since put there themselves.
set -e
case "$1" in
  remove|deconfigure)
    for n in install-sysible sysible-install install-sysible-controller; do
      link="/usr/local/bin/$n"
      if [ -L "$link" ] && [ "$(readlink "$link")" = "/usr/sbin/$n" ]; then
        rm -f "$link"
      fi
    done
    ;;
esac
#DEBHELPER#
exit 0
