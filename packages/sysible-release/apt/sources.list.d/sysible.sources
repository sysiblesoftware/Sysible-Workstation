# Sysible Workstation — the only repo Sysible itself publishes (sysible-* packages).
# Everything else comes from Debian or the upstream vendor repos below.
# Enabled: repo.sysible.com is live (Cloudflare R2). If you ever take the repo
# down, set Enabled to no first — an enabled entry pointing at a dead host makes
# every `apt update` fail.
Types: deb
Enabled: yes
URIs: https://repo.sysible.com/apt
Suites: sysible-stable
Components: main
Architectures: amd64 arm64
Signed-By: /usr/share/keyrings/sysible-archive-keyring.gpg
