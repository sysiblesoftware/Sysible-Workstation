# Sysible Workstation GNOME defaults. These set DEFAULT values only — a user is free
# to change any of them; they just land on brand out of the box.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/sysible/sysible-topographic-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/sysible/sysible-topographic.jpg'
picture-options='zoom'
primary-color='#0b0d12'
secondary-color='#0b0d12'

# NOTE: org.gnome.desktop.screensaver is NOT set here, deliberately.
#
# This block used to carry picture-uri / picture-options / primary-color and
# none of them did anything. GNOME Shell 43 builds the unlock dialog's
# background with a BackgroundManager given no settingsSchema, so it falls back
# to org.gnome.desktop.background (js/ui/unlockDialog.js, js/ui/background.js).
# The screensaver schema still HAS a picture-uri key, which is exactly the trap:
# setting it looks like configuring the lock screen and changes nothing.
#
# The keys the lock screen does read from this schema are lock-enabled,
# lock-delay and user-switch-enabled; we keep GNOME's defaults for all three.

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='green'

# NOTE: the dock's favorite-apps lives in ONE place — the dconf system-db at
# /etc/dconf/db/local.d/00-sysible-desktop — which overrides any gschema default,
# so it is intentionally NOT redefined here. A prior copy here pinned a different
# SysTerm id ('io.systerm.SysTerm.desktop') and the un-installed 'code.desktop',
# which just produced blank dock tiles. Keep the single source of truth.

# Kali-style FIXED workspaces: four static workspaces instead of GNOME's default
# dynamic set (which grows/shrinks and usually shows just 1-2). Also delivered via
# /etc/dconf on the ISO, but shipped here too so `apt upgrade` puts it on systems
# installed from an older image. Defaults only — users can still change them.
[org.gnome.mutter]
dynamic-workspaces=false
workspaces-only-on-primary=false

[org.gnome.desktop.wm.preferences]
num-workspaces=4

[org.gnome.desktop.wm.keybindings]
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
move-to-workspace-1=['<Super><Shift>1']
move-to-workspace-2=['<Super><Shift>2']
move-to-workspace-3=['<Super><Shift>3']
move-to-workspace-4=['<Super><Shift>4']
