# Sysible Linux GNOME defaults. These set DEFAULT values only — a user is free
# to change any of them; they just land on brand out of the box.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/sysible/sysible-mesh-dark.jpg'
picture-uri-dark='file:///usr/share/backgrounds/sysible/sysible-mesh-dark.jpg'
picture-options='zoom'
primary-color='#0b0d12'
secondary-color='#0b0d12'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/sysible/sysible-mesh-dark.jpg'
picture-options='zoom'
primary-color='#0b0d12'

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='blue'

[org.gnome.shell]
favorite-apps=['io.systerm.SysTerm.desktop', 'org.gnome.Nautilus.desktop', 'code.desktop', 'firefox-esr.desktop']
